USER ```html
USER <!DOCTYPE html>
USER <html lang="en">
USER <head>
USER     <meta charset="UTF-8">
USER     <title>Address Book</title>
USER     <link rel="stylesheet" href="css/styles.css">
USER </head>
USER <body>
USER     <div class="container">
USER         <h1>Address Book</h1>
USER         
USER         <div class="search-bar">
USER             <input type="text" id="searchInput" placeholder="Search by name or category...">
USER             <button onclick="searchContacts()">Search</button>
USER         </div>
USER 
USER         <form id="contactForm">
USER             <input type="hidden" id="contactId">
USER             <input type="text" id="firstName" placeholder="First Name" required>
USER             <input type="text" id="lastName" placeholder="Last Name" required>
USER             <input type="email" id="email" placeholder="Email" required>
USER             <input type="text" id="phoneNumber" placeholder="Phone Number" required>
USER             <input type="text" id="address" placeholder="Address" required>
USER             <input type="text" id="category" placeholder="Category (e.g. Family)" required>
USER             <button type="submit" id="submitBtn">Add Contact</button>
USER             <button type="button" id="cancelBtn" onclick="resetForm()" style="display:none;">Cancel</button>
USER         </form>
USER 
USER         <table id="contactTable">
USER             <thead>
USER                 <tr>
USER                     <th>Name</th>
USER                     <th>Email</th>
USER                     <th>Phone</th>
USER                     <th>Category</th>
USER                     <th>Actions</th>
USER                 </tr>
USER             </thead>
USER             <tbody id="contactList"></tbody>
USER         </table>
USER     </div>
USER     <script src="js/app.js"></script>
USER </body>
USER </html>
