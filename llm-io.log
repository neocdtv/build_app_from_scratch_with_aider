ASSISTANT ### 6. `src/main/java/com/addressbook/service/ContactService.java`
ASSISTANT ```java
ASSISTANT package com.addressbook.service;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.repository.ContactRepository;
ASSISTANT import org.springframework.stereotype.Service;
ASSISTANT 
ASSISTANT import java.util.List;
ASSISTANT 
ASSISTANT @Service
ASSISTANT public class ContactService {
ASSISTANT 
ASSISTANT     private final ContactRepository contactRepository;
ASSISTANT 
ASSISTANT     public ContactService(ContactRepository contactRepository) {
ASSISTANT         this.contactRepository = contactRepository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> getAllContacts() {
ASSISTANT         return contactRepository.findAll();
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact getContactById(Long id) {
ASSISTANT         return contactRepository.findById(id).orElse(null);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact createContact(Contact contact) {
ASSISTANT         return contactRepository.save(contact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact updateContact(Long id, Contact updatedContact) {
ASSISTANT         Contact existing = contactRepository.findById(id).orElse(null);
ASSISTANT         if (existing == null) return null;
ASSISTANT 
ASSISTANT         existing.setFirstName(updatedContact.getFirstName());
ASSISTANT         existing.setLastName(updatedContact.getLastName());
ASSISTANT         existing.setEmail(updatedContact.getEmail());
ASSISTANT         existing.setPhoneNumber(updatedContact.getPhoneNumber());
ASSISTANT         existing.setAddress(updatedContact.getAddress());
ASSISTANT         existing.setCategory(updatedContact.getCategory());
ASSISTANT         return contactRepository.save(existing);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public boolean deleteContact(Long id) {
ASSISTANT         if (contactRepository.existsById(id)) {
ASSISTANT             contactRepository.deleteById(id);
ASSISTANT             return true;
ASSISTANT         }
ASSISTANT         return false;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> searchContacts(String query) {
ASSISTANT         return contactRepository.searchContacts(query);
ASSISTANT     }
ASSISTANT }
ASSISTANT ```
