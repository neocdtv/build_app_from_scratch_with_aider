USER package com.addressbook.model;
USER 
USER import jakarta.persistence.*;
USER import jakarta.validation.constraints.*;
USER import lombok.Data;
USER import lombok.NoArgsConstructor;
USER import lombok.AllArgsConstructor;
USER 
USER @Entity
USER @Data
USER @NoArgsConstructor
USER @AllArgsConstructor
USER public class Contact {
USER     @Id
USER     @GeneratedValue(strategy = GenerationType.IDENTITY)
USER     private Long id;
USER 
USER     @NotBlank
USER     @Size(max = 50)
USER     private String firstName;
USER 
USER     @NotBlank
USER     @Size(max = 50)
USER     private String lastName;
USER 
USER     @NotBlank
USER     @Email
USER     @Size(max = 100)
USER     private String email;
USER 
USER     @NotBlank
USER     @Size(max = 20)
USER     private String phoneNumber;
USER 
USER     @NotBlank
USER     @Size(max = 255)
USER     private String address;
USER 
USER     @NotBlank
USER     @Size(max = 50)
USER     private String category;
USER }
