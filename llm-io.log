ASSISTANT package com.addressbook.service;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.repository.ContactRepository;
ASSISTANT import org.springframework.http.HttpStatus;
ASSISTANT import org.springframework.stereotype.Service;
ASSISTANT import org.springframework.web.server.ResponseStatusException;
ASSISTANT 
ASSISTANT import java.util.List;
ASSISTANT 
ASSISTANT @Service
ASSISTANT public class ContactService {
ASSISTANT 
ASSISTANT     private final ContactRepository contactRepository;
ASSISTANT 
ASSISTANT     public ContactService(ContactRepository contactRepository) {
ASSISTANT         this.contactRepository = contactRepository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> findAll() {
ASSISTANT         return contactRepository.findAll();
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact findById(Long id) {
ASSISTANT         return contactRepository.findById(id).orElseThrow(() -> 
ASSISTANT             new ResponseStatusException(HttpStatus.NOT_FOUND, "Contact not found with id: " + id));
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact create(Contact contact) {
ASSISTANT         return contactRepository.save(contact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact update(Long id, Contact updatedContact) {
ASSISTANT         Contact existing = findById(id);
ASSISTANT         existing.setFirstName(updatedContact.getFirstName());
ASSISTANT         existing.setLastName(updatedContact.getLastName());
ASSISTANT         existing.setEmail(updatedContact.getEmail());
ASSISTANT         existing.setPhoneNumber(updatedContact.getPhoneNumber());
ASSISTANT         existing.setAddress(updatedContact.getAddress());
ASSISTANT         existing.setCategory(updatedContact.getCategory());
ASSISTANT         return contactRepository.save(existing);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public void deleteById(Long id) {
ASSISTANT         if (!contactRepository.existsById(id)) {
ASSISTANT             throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Contact not found with id: " + id);
ASSISTANT         }
ASSISTANT         contactRepository.deleteById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> search(String query) {
ASSISTANT         // If empty query, return all (optional optimization), or just pass to repo logic
ASSISTANT         if (query == null || query.trim().isEmpty()) {
ASSISTANT             return findAll();
ASSISTANT         }
ASSISTANT         String[] parts = query.split("\\s+");
ASSISTANT         
ASSISTANT         StringBuilder sb = new StringBuilder();
ASSISTANT         for (String part : parts) {
ASSISTANT             sb.append(part).append("%"); // append wildcard for contains
ASSISTANT         }
ASSISTANT         String searchPattern = sb.toString();
ASSISTANT         
ASSISTANT         return contactRepository.findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCaseOrCategoryContainingIgnoreCase(
ASSISTANT                 searchPattern, searchPattern, searchPattern);
ASSISTANT     }
ASSISTANT }
ASSISTANT ```
