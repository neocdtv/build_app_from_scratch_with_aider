USER ```javascript
USER const API_URL = '/api/contacts';
USER const contactForm = document.getElementById('contactForm');
USER const contactList = document.getElementById('contactList');
USER 
USER document.addEventListener('DOMContentLoaded', fetchContacts);
USER 
USER contactForm.addEventListener('submit', async (e) => {
USER     e.preventDefault();
USER     const id = document.getElementById('contactId').value;
USER     const contact = {
USER         firstName: document.getElementById('firstName').value,
USER         lastName: document.getElementById('lastName').value,
USER         email: document.getElementById('email').value,
USER         phoneNumber: document.getElementById('phoneNumber').value,
USER         address: document.getElementById('address').value,
USER         category: document.getElementById('category').value
USER     };
USER 
USER     const method = id ? 'PUT' : 'POST';
USER     const url = id ? `${API_URL}/${id}` : API_URL;
USER 
USER     await fetch(url, {
USER         method,
USER         headers: { 'Content-Type': 'application/json' },
USER         body: JSON.stringify(contact)
USER     });
USER 
USER     resetForm();
USER     fetchContacts();
USER });
USER 
USER async function fetchContacts() {
USER     const res = await fetch(API_URL);
USER     const contacts = await res.json();
USER     renderContacts(contacts);
USER }
USER 
USER async function searchContacts() {
USER     const query = document.getElementById('searchInput').value;
USER     const res = await fetch(`${API_URL}/search?q=${encodeURIComponent(query)}`);
USER     const contacts = await res.json();
USER     renderContacts(contacts);
USER }
USER 
USER function renderContacts(contacts) {
USER     contactList.innerHTML = '';
USER     contacts.forEach(c => {
USER         const tr = document.createElement('tr');
USER         tr.innerHTML = `
USER             <td>${c.firstName} ${c.lastName}</td>
USER             <td>${c.email}</td>
USER             <td>${c.phoneNumber}</td>
USER             <td>${c.category}</td>
USER             <td>
USER                 <button class="edit-btn" onclick="editContact(${c.id})">Edit</button>
USER                 <button class="delete-btn" onclick="deleteContact(${c.id})">Delete</button>
USER             </td>
USER         `;
USER         contactList.appendChild(tr);
USER     });
USER }
USER 
USER async function deleteContact(id) {
USER     if (confirm('Delete this contact?')) {
USER         await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
USER         fetchContacts();
USER     }
USER }
USER 
USER async function editContact(id) {
USER     const res = await fetch(`${API_URL}/${id}`);
USER     const c = await res.json();
USER     document.getElementById('contactId').value = c.id;
USER     document.getElementById('firstName').value = c.firstName;
USER     document.getElementById('lastName').value = c.lastName;
USER     document.getElementById('email').value = c.email;
USER     document.getElementById('phoneNumber').value = c.phoneNumber;
USER     document.getElementById('address').value = c.address;
USER     document.getElementById('category').value = c.category;
USER     document.getElementById('submitBtn').innerText = 'Update Contact';
USER     document.getElementById('cancelBtn').style.display = 'inline-block';
USER }
USER 
USER function resetForm() {
USER     contactForm.reset();
USER     document.getElementById('contactId').value = '';
USER     document.getElementById('submitBtn').innerText = 'Add Contact';
USER     document.getElementById('cancelBtn').style.display = 'none';
USER }
USER ```
