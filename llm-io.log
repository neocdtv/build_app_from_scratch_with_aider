ASSISTANT ### 7. `src/main/java/com/addressbook/controller/ContactController.java`
ASSISTANT ```java
ASSISTANT package com.addressbook.controller;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.service.ContactService;
ASSISTANT import jakarta.validation.Valid;
ASSISTANT import org.springframework.http.HttpStatus;
ASSISTANT import org.springframework.http.ResponseEntity;
ASSISTANT import org.springframework.web.bind.annotation.*;
ASSISTANT 
ASSISTANT import java.util.List;
ASSISTANT 
ASSISTANT @RestController
ASSISTANT @RequestMapping("/api/contacts")
ASSISTANT public class ContactController {
ASSISTANT 
ASSISTANT     private final ContactService contactService;
ASSISTANT 
ASSISTANT     public ContactController(ContactService contactService) {
ASSISTANT         this.contactService = contactService;
ASSISTANT     }
ASSISTANT 
ASSISTANT     @GetMapping
ASSISTANT     public List<Contact> getAllContacts() {
ASSISTANT         return contactService.getAllContacts();
ASSISTANT     }
ASSISTANT 
ASSISTANT     @GetMapping("/{id}")
ASSISTANT     public ResponseEntity<Contact> getContactById(@PathVariable Long id) {
ASSISTANT         Contact contact = contactService.getContactById(id);
ASSISTANT         return contact != null ? ResponseEntity.ok(contact) : ResponseEntity.notFound().build();
ASSISTANT     }
ASSISTANT 
ASSISTANT     @PostMapping
ASSISTANT     public ResponseEntity<Contact> createContact(@Valid @RequestBody Contact contact) {
ASSISTANT         Contact saved = contactService.createContact(contact);
ASSISTANT         return ResponseEntity.status(HttpStatus.CREATED).body(saved);
ASSISTANT     }
ASSISTANT 
ASSISTANT     @PutMapping("/{id}")
ASSISTANT     public ResponseEntity<Contact> updateContact(@PathVariable Long id, @Valid @RequestBody Contact contact) {
ASSISTANT         Contact updated = contactService.updateContact(id, contact);
ASSISTANT         return updated != null ? ResponseEntity.ok(updated) : ResponseEntity.notFound().build();
ASSISTANT     }
ASSISTANT 
ASSISTANT     @DeleteMapping("/{id}")
ASSISTANT     public ResponseEntity<Void> deleteContact(@PathVariable Long id) {
ASSISTANT         boolean deleted = contactService.deleteContact(id);
ASSISTANT         return deleted ? ResponseEntity.noContent().build() : ResponseEntity.notFound().build();
ASSISTANT     }
ASSISTANT 
ASSISTANT     @GetMapping("/search")
ASSISTANT     public List<Contact> searchContacts(@RequestParam String q) {
ASSISTANT         return contactService.searchContacts(q);
ASSISTANT     }
ASSISTANT }
ASSISTANT ```
