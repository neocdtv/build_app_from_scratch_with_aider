ASSISTANT     }
ASSISTANT 
ASSISTANT     @PutMapping("/{id}")
ASSISTANT     public ResponseEntity<Contact> updateContact(@PathVariable Long id, @Valid @RequestBody Contact contactDetails) {
ASSISTANT         Optional<Contact> existingContact = contactService.findById(id);
ASSISTANT         if (existingContact.isPresent()) {
ASSISTANT             Contact contact = existingContact.get();
ASSISTANT             contact.setFirstName(contactDetails.getFirstName());
ASSISTANT             contact.setLastName(contactDetails.getLastName());
ASSISTANT             contact.setEmail(contactDetails.getEmail());
ASSISTANT             contact.setPhoneNumber(contactDetails.getPhoneNumber());
ASSISTANT             contact.setAddress(contactDetails.getAddress());
ASSISTANT             contact.setCategory(contactDetails.getCategory());
ASSISTANT             Contact updatedContact = contactService.save(contact);
ASSISTANT             return ResponseEntity.ok(updatedContact);
ASSISTANT         } else {
ASSISTANT             return ResponseEntity.notFound().build();
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     @DeleteMapping("/{id}")
ASSISTANT     public ResponseEntity<Void> deleteContact(@PathVariable Long id) {
