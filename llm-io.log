USER ```java
USER package com.addressbook.service;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import org.springframework.http.HttpStatus;
USER import org.springframework.stereotype.Service;
USER import org.springframework.web.server.ResponseStatusException;
USER 
USER import java.util.List;
USER 
USER @Service
USER public class ContactService {
USER 
USER     private final ContactRepository contactRepository;
USER 
USER     public ContactService(ContactRepository contactRepository) {
USER         this.contactRepository = contactRepository;
USER     }
USER 
USER     public List<Contact> findAll() {
USER         return contactRepository.findAll();
USER     }
USER 
USER     public Contact findById(Long id) {
USER         return contactRepository.findById(id).orElseThrow(() -> 
USER             new ResponseStatusException(HttpStatus.NOT_FOUND, "Contact not found with id: " + id));
USER     }
USER 
USER     public Contact create(Contact contact) {
USER         return contactRepository.save(contact);
USER     }
USER 
USER     public Contact update(Long id, Contact updatedContact) {
USER         Contact existing = findById(id);
USER         existing.setFirstName(updatedContact.getFirstName());
USER         existing.setLastName(updatedContact.getLastName());
USER         existing.setEmail(updatedContact.getEmail());
USER         existing.setPhoneNumber(updatedContact.getPhoneNumber());
USER         existing.setAddress(updatedContact.getAddress());
USER         existing.setCategory(updatedContact.getCategory());
USER         return contactRepository.save(existing);
USER     }
USER 
USER     public void deleteById(Long id) {
USER         if (!contactRepository.existsById(id)) {
USER             throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Contact not found with id: " + id);
USER         }
USER         contactRepository.deleteById(id);
USER     }
USER 
USER     public List<Contact> search(String query) {
USER         // If empty query, return all (optional optimization), or just pass to repo logic
USER         if (query == null || query.trim().isEmpty()) {
USER             return findAll();
USER         }
USER         String[] parts = query.split("\\s+");
USER         
USER         StringBuilder sb = new StringBuilder();
USER         for (String part : parts) {
USER             sb.append(part).append("%"); // append wildcard for contains
USER         }
USER         String searchPattern = sb.toString();
USER         
USER         return contactRepository.findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCaseOrCategoryContainingIgnoreCase(
USER                 searchPattern, searchPattern, searchPattern);
USER     }
USER }
USER ```
