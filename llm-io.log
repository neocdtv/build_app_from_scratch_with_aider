ASSISTANT import java.util.List;
ASSISTANT 
ASSISTANT @RestController
ASSISTANT @RequestMapping("/api/contacts")
ASSISTANT public class ContactController {
ASSISTANT     private final ContactService contactService;
ASSISTANT 
ASSISTANT     public ContactController(ContactService contactService) {
ASSISTANT         this.contactService = contactService;
ASSISTANT     }
ASSISTANT 
ASSISTANT     @GetMapping
ASSISTANT     public List<Contact> getAll() { return contactService.findAll(); }
ASSISTANT 
ASSISTANT     @GetMapping("/{id}")
ASSISTANT     public ResponseEntity<Contact> getById(@PathVariable Long id) {
ASSISTANT         return contactService.findById(id)
ASSISTANT                 .map(ResponseEntity::ok)
ASSISTANT                 .orElse(ResponseEntity.notFound().build());
ASSISTANT     }
ASSISTANT 
ASSISTANT     @PostMapping
ASSISTANT     public ResponseEntity<Contact> create(@Valid @RequestBody Contact contact) {
ASSISTANT         Contact created = contactService.create(contact);
ASSISTANT         URI location = URI.create("/api/contacts/" + created.getId());
ASSISTANT         return ResponseEntity.created(location).body(created);
ASSISTANT     }
ASSISTANT 
ASSISTANT     @PutMapping("/{id}")
ASSISTANT     public ResponseEntity<Contact> update(@PathVariable Long id, @Valid @RequestBody Contact contact) {
ASSISTANT         if (!contactService.findById(id).isPresent()) {
ASSISTANT             return ResponseEntity.notFound().build();
ASSISTANT         }
ASSISTANT         contact.setId(id);
ASSISTANT         Contact updated = contactService.update(contact);
ASSISTANT         return ResponseEntity.ok(updated);
ASSISTANT     }
ASSISTANT 
ASSISTANT     @DeleteMapping("/{id}")
ASSISTANT     public ResponseEntity<Void> delete(@PathVariable Long id) {
ASSISTANT         if (!contactService.findById(id).isPresent()) {
ASSISTANT             return ResponseEntity.notFound().build();
ASSISTANT         }
ASSISTANT         contactService.deleteById(id);
ASSISTANT         return ResponseEntity.noContent().build();
ASSISTANT     }
ASSISTANT 
ASSISTANT     @GetMapping("/search")
ASSISTANT     public List<Contact> search(@RequestParam String q) {
ASSISTANT         return contactService.search(q);
ASSISTANT     }
ASSISTANT }
