USER :root { --primary: #2563eb; --danger: #dc2626; --bg: #f8fafc; --border: #e2e8f0; }
USER body { font-family: system-ui, sans-serif; background: var(--bg); margin: 0; padding: 20px; color: #1e293b; }
USER .container { max-width: 1100px; margin: 0 auto; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
USER header { text-align: center; margin-bottom: 20px; color: var(--primary); }
USER #search-section { display: flex; gap: 10px; margin-bottom: 25px; }
USER #searchInput { flex: 1; padding: 8px; border: 1px solid var(--border); border-radius: 4px; }
USER form { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px; padding: 15px; background: #f1f5f9; border-radius: 6px; }
USER .form-group { display: flex; flex-direction: column; }
USER label { font-size: 0.85rem; margin-bottom: 4px; font-weight: 500; }
USER input { padding: 8px; border: 1px solid var(--border); border-radius: 4px; }
USER input:focus { outline: none; border-color: var(--primary); }
USER .button-group { grid-column: 1 / -1; display: flex; gap: 10px; justify-content: flex-end; }
USER button { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-weight: 500; }
USER #submitBtn { background: var(--primary); color: white; }
USER #cancelBtn { background: #94a3b8; color: white; }
USER button:hover { opacity: 0.9; }
USER table { width: 100%; border-collapse: collapse; margin-top: 10px; }
USER th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border); }
