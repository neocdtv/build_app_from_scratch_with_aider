ASSISTANT ### `src/main/resources/static/js/app.js`
ASSISTANT ```javascript
ASSISTANT document.addEventListener('DOMContentLoaded', () => {
ASSISTANT     const API_URL = '/api/contacts';
ASSISTANT     
ASSISTANT     const searchInput = document.getElementById('searchInput');
ASSISTANT     const searchBtn = document.getElementById('searchBtn');
ASSISTANT     const addContactBtn = document.getElementById('addContactBtn');
ASSISTANT     const contactList = document.getElementById('contactList');
ASSISTANT     const dialog = document.getElementById('contactDialog');
ASSISTANT     const form = document.getElementById('contactForm');
ASSISTANT     const closeDialogBtn = document.getElementById('closeDialogBtn');
ASSISTANT     const formTitle = document.getElementById('formTitle');
ASSISTANT 
ASSISTANT     loadContacts();
ASSISTANT 
ASSISTANT     searchBtn.addEventListener('click', () => loadContacts(searchInput.value));
ASSISTANT     addContactBtn.addEventListener('click', openForm);
ASSISTANT     closeDialogBtn.addEventListener('click', () => dialog.close());
ASSISTANT     form.addEventListener('submit', saveContact);
ASSISTANT 
ASSISTANT     async function loadContacts(query = '') {
ASSISTANT         contactList.innerHTML = '<p>Loading...</p>';
ASSISTANT         try {
ASSISTANT             let url = query ? `${API_URL}/search?q=${encodeURIComponent(query)}` : API_URL;
ASSISTANT             const response = await fetch(url);
ASSISTANT             if (!response.ok) throw new Error('Failed to fetch contacts');
ASSISTANT             
ASSISTANT             const contacts = await response.json();
ASSISTANT             renderContacts(contacts);
ASSISTANT         } catch (error) {
ASSISTANT             contactList.innerHTML = `<p style="color: red;">Error loading contacts: ${error.message}</p>`;
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     function renderContacts(contacts) {
ASSISTANT         if (contacts.length === 0) {
ASSISTANT             contactList.innerHTML = '<p>No contacts found.</p>';
ASSISTANT             return;
ASSISTANT         }
ASSISTANT 
ASSISTANT         contactList.innerHTML = '';
ASSISTANT         contacts.forEach(contact => {
ASSISTANT             const card = document.createElement('div');
ASSISTANT             card.className = 'contact-card';
ASSISTANT             card.dataset.id = contact.id;
ASSISTANT             card.innerHTML = `
ASSISTANT                 <span class="contact-category">${escapeHtml(contact.category)}</span>
ASSISTANT                 <h3>${escapeHtml(contact.firstName)} ${escapeHtml(contact.lastName)}</h3>
ASSISTANT                 <p><strong>Email:</strong> ${escapeHtml(contact.email)}</p>
ASSISTANT                 <p><strong>Phone:</strong> ${escapeHtml(contact.phoneNumber)}</p>
ASSISTANT                 <p><strong>Address:</strong> ${escapeHtml(contact.address)}</p>
ASSISTANT                 <div class="card-actions">
ASSISTANT                     <button class="btn-edit">Edit</button>
ASSISTANT                     <button class="btn-delete">Delete</button>
ASSISTANT                 </div>
ASSISTANT             `;
ASSISTANT             contactList.appendChild(card);
ASSISTANT         });
ASSISTANT 
ASSISTANT         document.querySelectorAll('.btn-edit').forEach(btn => {
ASSISTANT             btn.addEventListener('click', (e) => editContact(e.target.closest('.contact-card').dataset.id));
ASSISTANT         });
ASSISTANT         document.querySelectorAll('.btn-delete').forEach(btn => {
ASSISTANT             btn.addEventListener('click', (e) => deleteContact(e.target.closest('.contact-card').dataset.id));
ASSISTANT         });
ASSISTANT     }
ASSISTANT 
ASSISTANT     function openForm(contact = null) {
ASSISTANT         form.reset();
ASSISTANT         document.getElementById('contactId').value = '';
ASSISTANT         
ASSISTANT         if (contact) {
ASSISTANT             formTitle.textContent = 'Edit Contact';
ASSISTANT             document.getElementById('contactId').value = contact.id;
ASSISTANT             document.getElementById('firstName').value = contact.firstName;
ASSISTANT             document.getElementById('lastName').value = contact.lastName;
ASSISTANT             document.getElementById('email').value = contact.email;
