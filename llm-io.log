USER     public ResponseEntity<Contact> createContact(@Valid @RequestBody Contact contact) {
USER         Contact saved = contactService.createContact(contact);
USER         return ResponseEntity.status(HttpStatus.CREATED).body(saved);
USER     }
USER 
USER     @PutMapping("/{id}")
USER     public ResponseEntity<Contact> updateContact(@PathVariable Long id, @Valid @RequestBody Contact contactDetails) {
USER         Contact updated = contactService.updateContact(id, contactDetails);
USER         return ResponseEntity.ok(updated);
USER     }
USER 
USER     @DeleteMapping("/{id}")
USER     public ResponseEntity<?> deleteContact(@PathVariable Long id) {
USER         return contactService.deleteContact(id);
USER     }
USER 
USER     @GetMapping("/search")
USER     public List<Contact> searchContacts(@RequestParam String q) {
USER         return contactService.searchContacts(q);
USER     }
USER }
