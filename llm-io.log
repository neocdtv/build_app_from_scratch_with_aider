ASSISTANT function escapeHtml(text) {
ASSISTANT     if (text === null || text === undefined) return '';
ASSISTANT     const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
ASSISTANT     return String(text).replace(/[&<>"']/g, function(m) { return map[m]; });
