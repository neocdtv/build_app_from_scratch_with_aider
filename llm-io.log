USER     const noData = document.getElementById('noData');
USER     tbody.innerHTML = '';
USER     
USER     if (data.length === 0) {
USER         noData.classList.remove('hidden');
USER         return;
USER     }
USER     noData.classList.add('hidden');
USER 
USER     data.forEach(c => {
USER         const tr = document.createElement('tr');
