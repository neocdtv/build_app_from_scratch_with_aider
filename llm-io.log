USER src/main/java/com/addressbook/service/ContactService.java
USER ````
USER package com.addressbook.service;
USER 
USER import com.addressbook.exception.ResourceNotFoundException;
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import org.springframework.http.ResponseEntity;
USER import org.springframework.stereotype.Service;
USER 
USER import java.util.List;
USER import java.util.Optional;
USER 
USER @Service
USER public class ContactService {
USER 
USER     private final ContactRepository contactRepository;
USER 
USER     public ContactService(ContactRepository contactRepository) {
USER         this.contactRepository = contactRepository;
USER     }
USER 
USER     public List<Contact> getAllContacts() {
USER         return contactRepository.findAll();
USER     }
USER 
USER     public Optional<Contact> getContactById(Long id) {
USER         return contactRepository.findById(id);
USER     }
USER 
USER     public Contact createContact(Contact contact) {
USER         return contactRepository.save(contact);
USER     }
USER 
USER     public Contact updateContact(Long id, Contact contactDetails) {
USER         Contact contact = contactRepository.findById(id)
USER                 .orElseThrow(() -> new ResourceNotFoundException("Contact not found with id: " + id));
USER 
USER         contact.setFirstName(contactDetails.getFirstName());
USER         contact.setLastName(contactDetails.getLastName());
USER         contact.setEmail(contactDetails.getEmail());
USER         contact.setPhoneNumber(contactDetails.getPhoneNumber());
USER         contact.setAddress(contactDetails.getAddress());
USER         contact.setCategory(contactDetails.getCategory());
USER 
USER         return contactRepository.save(contact);
USER     }
USER 
USER     public ResponseEntity<?> deleteContact(Long id) {
USER         Contact contact = contactRepository.findById(id)
USER                 .orElseThrow(() -> new ResourceNotFoundException("Contact not found with id: " + id));
USER 
USER         contactRepository.delete(contact);
USER         return ResponseEntity.noContent().build();
USER     }
USER 
USER     public List<Contact> searchContacts(String query) {
USER         return contactRepository.searchContacts(query);
USER     }
USER }
USER ````
