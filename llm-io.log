USER ### 5. `src/main/java/com/addressbook/repository/ContactRepository.java`
USER ```java
USER package com.addressbook.repository;
USER 
USER import com.addressbook.model.Contact;
USER import org.springframework.data.jpa.repository.JpaRepository;
USER import org.springframework.data.jpa.repository.Query;
USER import org.springframework.data.repository.query.Param;
USER import org.springframework.stereotype.Repository;
USER 
USER import java.util.List;
USER 
USER @Repository
USER public interface ContactRepository extends JpaRepository<Contact, Long> {
USER     @Query("SELECT c FROM Contact c WHERE LOWER(c.firstName) LIKE LOWER(CONCAT('%', :query, '%')) " +
USER            "OR LOWER(c.lastName) LIKE LOWER(CONCAT('%', :query, '%')) " +
USER            "OR LOWER(c.category) LIKE LOWER(CONCAT('%', :query, '%'))")
USER     List<Contact> searchContacts(@Param("query") String query);
USER }
USER ```
USER 
USER ### 6. `src/main/java/com/addressbook/service/ContactService.java`
USER ```java
USER package com.addressbook.service;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import org.springframework.stereotype.Service;
USER 
USER import java.util.List;
USER 
USER @Service
USER public class ContactService {
USER 
USER     private final ContactRepository contactRepository;
USER 
USER     public ContactService(ContactRepository contactRepository) {
USER         this.contactRepository = contactRepository;
USER     }
USER 
USER     public List<Contact> getAllContacts() {
USER         return contactRepository.findAll();
USER     }
USER 
USER     public Contact getContactById(Long id) {
USER         return contactRepository.findById(id).orElse(null);
USER     }
USER 
USER     public Contact createContact(Contact contact) {
USER         return contactRepository.save(contact);
USER     }
USER 
USER     public Contact updateContact(Long id, Contact updatedContact) {
USER         Contact existing = contactRepository.findById(id).orElse(null);
USER         if (existing == null) return null;
USER 
USER         existing.setFirstName(updatedContact.getFirstName());
USER         existing.setLastName(updatedContact.getLastName());
USER         existing.setEmail(updatedContact.getEmail());
USER         existing.setPhoneNumber(updatedContact.getPhoneNumber());
USER         existing.setAddress(updatedContact.getAddress());
USER         existing.setCategory(updatedContact.getCategory());
USER         return contactRepository.save(existing);
USER     }
USER 
USER     public boolean deleteContact(Long id) {
USER         if (contactRepository.existsById(id)) {
USER             contactRepository.deleteById(id);
USER             return true;
USER         }
USER         return false;
USER     }
USER 
USER     public List<Contact> searchContacts(String query) {
USER         return contactRepository.searchContacts(query);
USER     }
USER }
USER ```
USER 
USER ### 7. `src/main/java/com/addressbook/controller/ContactController.java`
USER ```java
USER package com.addressbook.controller;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.service.ContactService;
USER import jakarta.validation.Valid;
USER import org.springframework.http.HttpStatus;
USER import org.springframework.http.ResponseEntity;
USER import org.springframework.web.bind.annotation.*;
USER 
USER import java.util.List;
USER 
USER @RestController
USER @RequestMapping("/api/contacts")
USER public class ContactController {
USER 
USER     private final ContactService contactService;
USER 
USER     public ContactController(ContactService contactService) {
USER         this.contactService = contactService;
USER     }
USER 
USER     @GetMapping
USER     public List<Contact> getAllContacts() {
USER         return contactService.getAllContacts();
USER     }
USER 
USER     @GetMapping("/{id}")
USER     public ResponseEntity<Contact> getContactById(@PathVariable Long id) {
USER         Contact contact = contactService.getContactById(id);
USER         return contact != null ? ResponseEntity.ok(contact) : ResponseEntity.notFound().build();
USER     }
USER 
USER     @PostMapping
USER     public ResponseEntity<Contact> createContact(@Valid @RequestBody Contact contact) {
USER         Contact saved = contactService.createContact(contact);
USER         return ResponseEntity.status(HttpStatus.CREATED).body(saved);
USER     }
USER 
USER     @PutMapping("/{id}")
USER     public ResponseEntity<Contact> updateContact(@PathVariable Long id, @Valid @RequestBody Contact contact) {
USER         Contact updated = contactService.updateContact(id, contact);
USER         return updated != null ? ResponseEntity.ok(updated) : ResponseEntity.notFound().build();
USER     }
USER 
USER     @DeleteMapping("/{id}")
USER     public ResponseEntity<Void> deleteContact(@PathVariable Long id) {
USER         boolean deleted = contactService.deleteContact(id);
USER         return deleted ? ResponseEntity.noContent().build() : ResponseEntity.notFound().build();
USER     }
USER 
USER     @GetMapping("/search")
USER     public List<Contact> searchContacts(@RequestParam String q) {
USER         return contactService.searchContacts(q);
USER     }
USER }
USER ```
