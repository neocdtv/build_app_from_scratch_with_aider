ASSISTANT ```java
ASSISTANT package com.addressbook.service;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.repository.ContactRepository;
ASSISTANT import org.springframework.stereotype.Service;
ASSISTANT import java.util.List;
ASSISTANT import java.util.NoSuchElementException;
ASSISTANT 
ASSISTANT @Service
ASSISTANT public class ContactService {
ASSISTANT     private final ContactRepository repository;
ASSISTANT 
ASSISTANT     public ContactService(ContactRepository repository) {
ASSISTANT         this.repository = repository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> findAll() {
ASSISTANT         return repository.findAll();
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact findById(Long id) {
ASSISTANT         return repository.findById(id)
ASSISTANT                 .orElseThrow(() -> new NoSuchElementException("Contact not found with id: " + id));
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact save(Contact contact) {
ASSISTANT         return repository.save(contact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public void deleteById(Long id) {
ASSISTANT         if (!repository.existsById(id)) {
ASSISTANT             throw new NoSuchElementException("Contact not found with id: " + id);
ASSISTANT         }
ASSISTANT         repository.deleteById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> search(String query) {
ASSISTANT         if (query == null || query.trim().isEmpty()) {
ASSISTANT             return findAll();
ASSISTANT         }
ASSISTANT         String q = query.toLowerCase();
ASSISTANT         List<Contact> byName = repository.findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCase(q, q);
ASSISTANT         List<Contact> byCategory = repository.findByCategoryContainingIgnoreCase(q);
ASSISTANT         
ASSISTANT         // Merge and deduplicate
ASSISTANT         List<Contact> merged = new java.util.ArrayList<>(byName);
ASSISTANT         for (Contact c : byCategory) {
ASSISTANT             if (merged.stream().noneMatch(existing -> existing.getId().equals(c.getId()))) {
ASSISTANT                 merged.add(c);
ASSISTANT             }
ASSISTANT         }
ASSISTANT         return merged;
ASSISTANT     }
ASSISTANT }
ASSISTANT ```
