USER const API = '/api/contacts';
USER const form = document.getElementById('contact-form');
USER const tbody = document.getElementById('contacts-body');
USER const searchInput = document.getElementById('search-input');
USER 
USER async function loadContacts(query = '') {
USER     const url = query ? `${API}/search?q=${encodeURIComponent(query)}` : API;
USER     try {
USER         const res = await fetch(url);
USER         const contacts = await res.json();
USER         tbody.innerHTML = '';
USER         contacts.forEach(c => {
USER             const tr = document.createElement('tr');
USER             tr.innerHTML = `
USER                 <td>${esc(c.firstName)} ${esc(c.lastName)}</td>
USER                 <td>${esc(c.email)}</td>
USER                 <td>${esc(c.phoneNumber)}</td>
USER                 <td>${esc(c.category)}</td>
USER                 <td>
USER                     <button onclick="editContact(${c.id})">Edit</button>
USER                     <button class="delete-btn" onclick="deleteContact(${c.id})">Delete</button>
USER                 </td>`;
USER             tbody.appendChild(tr);
USER         });
USER     } catch (e) { console.error('Fetch error', e); }
USER }
USER 
USER async function saveContact(e) {
USER     e.preventDefault();
USER     const id = document.getElementById('contact-id').value;
USER     const payload = {
USER         firstName: document.getElementById('firstName').value,
USER         lastName: document.getElementById('lastName').value,
USER         email: document.getElementById('email').value,
USER         phoneNumber: document.getElementById('phoneNumber').value,
USER         address: document.getElementById('address').value,
USER         category: document.getElementById('category').value
USER     };
USER     try {
USER         const method = id ? 'PUT' : 'POST';
USER         const url = id ? `${API}/${id}` : API;
USER         await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
USER         resetForm();
USER         loadContacts(searchInput.value);
USER     } catch (e) { alert('Save failed'); console.error(e); }
USER }
USER 
USER async function editContact(id) {
USER     try {
USER         const res = await fetch(`${API}/${id}`);
USER         const c = await res.json();
USER         document.getElementById('contact-id').value = c.id;
USER         document.getElementById('firstName').value = c.firstName;
USER         document.getElementById('lastName').value = c.lastName;
USER         document.getElementById('email').value = c.email;
USER         document.getElementById('phoneNumber').value = c.phoneNumber;
USER         document.getElementById('address').value = c.address;
USER         document.getElementById('category').value = c.category;
USER         document.getElementById('form-title').textContent = 'Edit Contact';
USER         document.getElementById('submit-btn').textContent = 'Update Contact';
USER     } catch (e) { console.error('Load failed', e); }
USER }
USER 
USER async function deleteContact(id) {
USER     if (!confirm('Delete this contact?')) return;
USER     await fetch(`${API}/${id}`, { method: 'DELETE' });
USER     loadContacts(searchInput.value);
USER }
USER 
USER function resetForm() {
