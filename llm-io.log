USER **File:** `src/main/resources/static/app.js`
USER ```javascript
USER const API_URL = '/api/contacts';
USER let currentEditId = null;
USER 
USER document.addEventListener('DOMContentLoaded', () => {
USER     loadContacts();
USER     document.getElementById('contactForm').addEventListener('submit', handleSubmit);
USER     document.getElementById('searchInput').addEventListener('keypress', (e) => {
USER         if(e.key === 'Enter') loadContacts();
USER     });
USER });
USER 
USER async function loadContacts() {
USER     const query = document.getElementById('searchInput').value.trim();
USER     const url = query ? `${API_URL}/search?q=${encodeURIComponent(query)}` : API_URL;
USER     
USER     try {
USER         const res = await fetch(url);
USER         const data = await res.json();
USER         renderTable(data);
USER     } catch (err) { console.error('Fetch error:', err); }
USER }
USER 
USER function renderTable(contacts) {
USER     const tbody = document.getElementById('contactList');
USER     tbody.innerHTML = '';
USER     contacts.forEach(c => {
USER         const tr = document.createElement('tr');
USER         tr.innerHTML = `
USER             <td>${esc(c.firstName)}</td><td>${esc(c.lastName)}</td><td>${esc(c.email)}</td>
USER             <td>${esc(c.phoneNumber)}</td><td>${esc(c.address)}</td><td>${esc(c.category)}</td>
USER             <td>
USER                 <button class="edit-btn" onclick="startEdit(${c.id})">Edit</button>
USER                 <button class="delete-btn" onclick="deleteContact(${c.id})">Delete</button>
USER             </td>
USER         `;
USER         tbody.appendChild(tr);
USER     });
USER }
USER 
USER async function handleSubmit(e) {
USER     e.preventDefault();
USER     const payload = {
USER         firstName: val('firstName'), lastName: val('lastName'), email: val('email'),
USER         phoneNumber: val('phoneNumber'), address: val('address'), category: val('category')
USER     };
USER     
USER     try {
USER         let res;
USER         if (currentEditId) {
USER             res = await fetch(`${API_URL}/${currentEditId}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
USER         } else {
USER             res = await fetch(API_URL, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
USER         }
USER         
USER         if (res.ok || res.status === 201) {
USER             resetForm();
USER             loadContacts();
USER         } else {
USER             const err = await res.json();
USER             alert('Validation/Server Error: ' + (err.message || JSON.stringify(err)));
USER         }
USER     } catch (err) { console.error(err); }
USER }
USER 
USER async function deleteContact(id) {
USER     if(!confirm('Delete this contact?')) return;
USER     const res = await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
USER     if (res.status === 204) loadContacts();
USER }
USER 
USER function startEdit(id) {
USER     fetch(`${API_URL}/${id}`).then(r => r.json()).then(c => {
USER         currentEditId = c.id;
USER         document.getElementById('contactId').value = c.id;
USER         document.getElementById('firstName').value = c.firstName;
USER         document.getElementById('lastName').value = c.lastName;
USER         document.getElementById('email').value = c.email;
USER         document.getElementById('phoneNumber').value = c.phoneNumber;
USER         document.getElementById('address').value = c.address;
USER         document.getElementById('category').value = c.category;
USER         document.getElementById('saveBtn').textContent = 'Update Contact';
USER     });
USER }
USER 
USER function resetForm() {
USER     currentEditId = null;
USER     document.getElementById('contactForm').reset();
USER     document.getElementById('saveBtn').textContent = 'Save Contact';
USER }
USER 
USER function val(id) { return document.getElementById(id).value.trim(); }
USER function esc(str) { const d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML; }
USER ```
