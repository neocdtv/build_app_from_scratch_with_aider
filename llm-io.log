USER ### 5. `src/main/java/com/addressbook/service/ContactService.java`
USER Handles business logic and delegates to repository.
USER ```java
USER package com.addressbook.service;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import org.springframework.stereotype.Service;
USER import java.util.List;
USER import java.util.NoSuchElementException;
USER 
USER @Service
USER public class ContactService {
USER     private final ContactRepository repository;
USER 
USER     public ContactService(ContactRepository repository) {
USER         this.repository = repository;
USER     }
USER 
USER     public List<Contact> findAll() {
USER         return repository.findAll();
USER     }
USER 
USER     public Contact findById(Long id) {
USER         return repository.findById(id)
USER                 .orElseThrow(() -> new NoSuchElementException("Contact not found with id: " + id));
USER     }
USER 
USER     public Contact create(Contact contact) {
USER         return repository.save(contact);
USER     }
USER 
USER     public Contact update(Long id, Contact updatedContact) {
USER         Contact existing = findById(id);
USER         existing.setFirstName(updatedContact.getFirstName());
USER         existing.setLastName(updatedContact.getLastName());
USER         existing.setEmail(updatedContact.getEmail());
USER         existing.setPhoneNumber(updatedContact.getPhoneNumber());
USER         existing.setAddress(updatedContact.getAddress());
USER         existing.setCategory(updatedContact.getCategory());
USER         return repository.save(existing);
USER     }
USER 
USER     public void delete(Long id) {
USER         findById(id);
USER         repository.deleteById(id);
USER     }
USER 
USER     public List<Contact> search(String query) {
USER         String q = (query != null && !query.isBlank()) ? query.trim() : "";
USER         return repository.findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCaseOrCategoryContainingIgnoreCase(q, q, q);
USER     }
USER }
USER ```
