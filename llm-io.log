ASSISTANT ### 11. `src/main/resources/static/app.js`
ASSISTANT ```javascript
ASSISTANT const API_BASE = '/api/contacts';
ASSISTANT const form = document.getElementById('contactForm');
ASSISTANT const contactList = document.getElementById('contactList');
ASSISTANT const searchInput = document.getElementById('searchInput');
ASSISTANT const searchBtn = document.getElementById('searchBtn');
ASSISTANT 
ASSISTANT let editingId = null;
ASSISTANT 
ASSISTANT document.addEventListener('DOMContentLoaded', () => fetchContacts());
ASSISTANT searchBtn.addEventListener('click', handleSearch);
ASSISTANT 
ASSISTANT async function fetchContacts() {
ASSISTANT     try {
ASSISTANT         const res = await fetch(API_BASE);
ASSISTANT         const contacts = await res.json();
ASSISTANT         renderContacts(contacts);
ASSISTANT     } catch (err) console.error('Failed to load contacts:', err);
ASSISTANT }
ASSISTANT 
ASSISTANT async function handleSearch() {
ASSISTANT     const query = searchInput.value.trim();
ASSISTANT     if (!query) return fetchContacts();
ASSISTANT     try {
ASSISTANT         const res = await fetch(`${API_BASE}/search?q=${encodeURIComponent(query)}`);
ASSISTANT         renderContacts(await res.json());
ASSISTANT     } catch (err) console.error('Search failed:', err);
ASSISTANT }
ASSISTANT 
ASSISTANT function renderContacts(contacts) {
ASSISTANT     contactList.innerHTML = '';
ASSISTANT     contacts.forEach(c => {
ASSISTANT         const tr = document.createElement('tr');
ASSISTANT         tr.innerHTML = `
ASSISTANT             <td>${c.firstName} ${c.lastName}</td>
ASSISTANT             <td>${c.email}</td>
ASSISTANT             <td>${c.phoneNumber}</td>
ASSISTANT             <td>${c.address}</td>
ASSISTANT             <td>${c.category}</td>
ASSISTANT             <td>
ASSISTANT                 <button class="action-btn edit-btn" onclick="editContact(${c.id})">Edit</button>
ASSISTANT                 <button class="action-btn delete-btn" onclick="deleteContact(${c.id})">Delete</button>
ASSISTANT             </td>`;
ASSISTANT         contactList.appendChild(tr);
ASSISTANT     });
ASSISTANT }
ASSISTANT 
ASSISTANT form.addEventListener('submit', async (e) => {
ASSISTANT     e.preventDefault();
ASSISTANT     const data = {
ASSISTANT         firstName: document.getElementById('firstName').value,
ASSISTANT         lastName: document.getElementById('lastName').value,
ASSISTANT         email: document.getElementById('email').value,
ASSISTANT         phoneNumber: document.getElementById('phoneNumber').value,
ASSISTANT         address: document.getElementById('address').value,
ASSISTANT         category: document.getElementById('category').value
ASSISTANT     };
ASSISTANT 
ASSISTANT     // Client-side validation refinement
ASSISTANT     const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
ASSISTANT     if (!emailRegex.test(data.email)) { alert('Invalid email format'); return; }
ASSISTANT 
ASSISTANT     try {
ASSISTANT         const method = editingId ? 'PUT' : 'POST';
ASSISTANT         const url = editingId ? `${API_BASE}/${editingId}` : API_BASE;
ASSISTANT         await fetch(url, {
ASSISTANT             method,
ASSISTANT             headers: { 'Content-Type': 'application/json' },
ASSISTANT             body: JSON.stringify(data)
ASSISTANT         });
ASSISTANT         resetForm();
ASSISTANT         fetchContacts();
ASSISTANT     } catch (err) console.error('Save failed:', err);
ASSISTANT });
ASSISTANT 
ASSISTANT async function editContact(id) {
ASSISTANT     try {
ASSISTANT         const res = await fetch(`${API_BASE}/${id}`);
ASSISTANT         const c = await res.json();
ASSISTANT         editingId = id;
ASSISTANT         document.getElementById('contactId').value = c.id;
ASSISTANT         document.getElementById('firstName').value = c.firstName;
ASSISTANT         document.getElementById('lastName').value = c.lastName;
ASSISTANT         document.getElementById('email').value = c.email;
ASSISTANT         document.getElementById('phoneNumber').value = c.phoneNumber;
ASSISTANT         document.getElementById('address').value = c.address;
ASSISTANT         document.getElementById('category').value = c.category;
ASSISTANT         document.getElementById('formTitle').textContent = 'Edit Contact';
ASSISTANT         document.getElementById('submitBtn').textContent = 'Update';
ASSISTANT         document.getElementById('cancelBtn').style.display = 'inline-block';
ASSISTANT     } catch (err) console.error('Load edit failed:', err);
ASSISTANT }
ASSISTANT 
ASSISTANT document.getElementById('cancelBtn').addEventListener('click', resetForm);
ASSISTANT 
ASSISTANT function resetForm() {
ASSISTANT     editingId = null;
ASSISTANT     form.reset();
ASSISTANT     document.getElementById('formTitle').textContent = 'Add Contact';
ASSISTANT     document.getElementById('submitBtn').textContent = 'Save';
ASSISTANT     document.getElementById('cancelBtn').style.display = 'none';
