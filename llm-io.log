USER #### `src/main/java/com/addressbook/repository/ContactRepository.java`
USER JPA Repository interface.
USER 
USER ```java
USER package com.addressbook.repository;
USER 
USER import com.addressbook.model.Contact;
USER import org.springframework.data.jpa.repository.JpaRepository;
USER import org.springframework.stereotype.Repository;
USER import java.util.List;
USER 
USER @Repository
USER public interface ContactRepository extends JpaRepository<Contact, Long> {
USER 
USER     List<Contact> findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCase(
USER         String firstName, String lastName);
USER     
USER     List<Contact> findByCategoryContainingIgnoreCase(String category);
USER     
USER     default List<Contact> searchByQuery(String query) {
USER         if (query == null || query.trim().isEmpty()) {
USER             return findAll();
USER         }
USER         // Search in First Name, Last Name, or Category
USER         List<Contact> nameMatches = findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCase(query, query);
USER         List<Contact> categoryMatches = findByCategoryContainingIgnoreCase(query);
USER         
USER         // Combine and remove duplicates based on ID
USER         java.util.Set<Long> ids = new java.util.HashSet<>();
USER         java.util.List<Contact> results = new java.util.ArrayList<>();
USER         
USER         for (Contact c : nameMatches) {
USER             if (ids.add(c.getId())) {
USER                 results.add(c);
USER             }
USER         }
USER         
USER         for (Contact c : categoryMatches) {
USER             if (ids.add(c.getId())) {
USER                 results.add(c);
USER             }
USER         }
USER         
USER         return results;
USER     }
USER }
USER ```
