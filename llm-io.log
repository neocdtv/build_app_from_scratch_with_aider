ASSISTANT #### 12. `src/main/resources/static/js/app.js`
ASSISTANT Vanilla JavaScript to handle Fetch API calls and client-side validation.
ASSISTANT 
ASSISTANT ```javascript
ASSISTANT document.addEventListener('DOMContentLoaded', () => {
ASSISTANT     const apiUrl = '/api/contacts';
ASSISTANT     let editingId = null;
ASSISTANT 
ASSISTANT     // DOM Elements
ASSISTANT     const contactList = document.getElementById('contact-list');
ASSISTANT     const formOverlay = document.getElementById('form-overlay');
ASSISTANT     const contactForm = document.getElementById('contact-form');
ASSISTANT     const saveBtn = document.getElementById('save-btn');
ASSISTANT     const cancelBtn = document.getElementById('cancel-btn');
ASSISTANT     const searchInput = document.getElementById('search-input');
ASSISTANT     const searchBtn = document.getElementById('search-btn');
ASSISTANT     const resetBtn = document.getElementById('reset-btn');
ASSISTANT 
ASSISTANT     // Load all contacts on init
ASSISTANT     loadContacts();
ASSISTANT 
ASSISTANT     // --- CRUD Operations ---
ASSISTANT 
ASSISTANT     // GET (Load All)
ASSISTANT     async function loadContacts() {
ASSISTANT         try {
ASSISTANT             const response = await fetch(apiUrl);
ASSISTANT             const contacts = await response.json();
ASSISTANT             renderContacts(contacts);
ASSISTANT         } catch (error) {
ASSISTANT             console.error('Error loading contacts:', error);
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     // GET Search (Filter)
ASSISTANT     async function searchContacts() {
ASSISTANT         const query = searchInput.value.trim();
ASSISTANT         if (!query) {
ASSISTANT             loadContacts(); // If empty, load all
ASSISTANT             return;
ASSISTANT         }
ASSISTANT         try {
ASSISTANT             const response = await fetch(`${apiUrl}/search?q=${encodeURIComponent(query)}`);
ASSISTANT             const contacts = await response.json();
ASSISTANT             renderContacts(contacts);
ASSISTANT         } catch (error) {
ASSISTANT             console.error('Error searching contacts:', error);
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     // POST (Create)
ASSISTANT     async function createContact(formData) {
ASSISTANT         try {
ASSISTANT             const response = await fetch(apiUrl, {
ASSISTANT                 method: 'POST',
ASSISTANT                 headers: { 'Content-Type': 'application/json' },
ASSISTANT                 body: JSON.stringify(formData)
ASSISTANT             });
ASSISTANT             if (response.ok) {
ASSISTANT                 closeModal();
ASSISTANT                 loadContacts();
ASSISTANT                 contactForm.reset();
ASSISTANT             } else {
ASSISTANT                 alert('Failed to create contact.');
ASSISTANT             }
ASSISTANT         } catch (error) {
ASSISTANT             console.error('Error creating contact:', error);
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     // PUT (Update)
ASSISTANT     async function updateContact(id, formData) {
ASSISTANT         try {
ASSISTANT             const response = await fetch(`${apiUrl}/${id}`, {
ASSISTANT                 method: 'PUT',
ASSISTANT                 headers: { 'Content-Type': 'application/json' },
ASSISTANT                 body: JSON.stringify(formData)
ASSISTANT             });
ASSISTANT             if (response.ok) {
ASSISTANT                 closeModal();
ASSISTANT                 loadContacts();
ASSISTANT             } else {
ASSISTANT                 alert('Failed to update contact.');
ASSISTANT             }
ASSISTANT         } catch (error) {
ASSISTANT             console.error('Error updating contact:', error);
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     // DELETE
ASSISTANT     async function deleteContact(id) {
ASSISTANT         if (!confirm('Are you sure you want to delete this contact?')) return;
ASSISTANT         try {
ASSISTANT             const response = await fetch(`${apiUrl}/${id}`, { method: 'DELETE' });
ASSISTANT             if (response.ok) {
ASSISTANT                 loadContacts();
ASSISTANT             } else {
ASSISTANT                 alert('Failed to delete contact.');
ASSISTANT             }
ASSISTANT         } catch (error) {
ASSISTANT             console.error('Error deleting contact:', error);
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     // --- UI Helpers ---
ASSISTANT 
ASSISTANT     function renderContacts(contacts) {
ASSISTANT         contactList.innerHTML = '';
ASSISTANT         if (contacts.length === 0) {
ASSISTANT             contactList.innerHTML = '<tr><td colspan="5">No contacts found.</td></tr>';
ASSISTANT             return;
ASSISTANT         }
ASSISTANT 
ASSISTANT         contacts.forEach(contact => {
ASSISTANT             const row = document.createElement('tr');
ASSISTANT             row.innerHTML = `
ASSISTANT                 <td>${contact.firstName} ${contact.lastName}</td>
ASSISTANT                 <td>${contact.email}</td>
ASSISTANT                 <td>${contact.phoneNumber}</td>
