USER package com.addressbook.model;
USER 
USER import jakarta.persistence.*;
USER import jakarta.validation.constraints.Email;
USER import jakarta.validation.constraints.NotBlank;
USER import jakarta.validation.constraints.Size;
USER 
USER @Entity
USER @Table(name = "contact")
USER public class Contact {
USER 
USER     @Id
USER     @GeneratedValue(strategy = GenerationType.IDENTITY)
USER     private Long id;
USER 
USER     @NotBlank(message = "First name is required")
USER     @Size(max = 50, message = "First name must be less than 50 characters")
USER     private String firstName;
USER 
USER     @NotBlank(message = "Last name is required")
USER     @Size(max = 50, message = "Last name must be less than 50 characters")
USER     private String lastName;
USER 
USER     @NotBlank(message = "Email is required")
USER     @Email(message = "Email should be valid")
USER     @Size(max = 100, message = "Email must be less than 100 characters")
USER     private String email;
USER 
USER     @NotBlank(message = "Phone number is required")
USER     @Size(max = 20, message = "Phone number must be less than 20 characters")
USER     private String phoneNumber;
USER 
USER     @NotBlank(message = "Address is required")
USER     @Size(max = 255, message = "Address must be less than 255 characters")
USER     private String address;
USER 
USER     @NotBlank(message = "Category is required")
USER     @Size(max = 50, message = "Category must be less than 50 characters")
USER     private String category;
USER 
USER     public Contact() {
USER     }
USER 
USER     public Long getId() {
USER         return id;
USER     }
USER 
USER     public void setId(Long id) {
USER         this.id = id;
USER     }
USER 
USER     public String getFirstName() {
USER         return firstName;
USER     }
USER 
USER     public void setFirstName(String firstName) {
USER         this.firstName = firstName;
USER     }
USER 
USER     public String getLastName() {
USER         return lastName;
USER     }
USER 
USER     public void setLastName(String lastName) {
USER         this.lastName = lastName;
USER     }
USER 
USER     public String getEmail() {
USER         return email;
USER     }
USER 
USER     public void setEmail(String email) {
USER         this.email = email;
USER     }
USER 
USER     public String getPhoneNumber() {
USER         return phoneNumber;
USER     }
USER 
USER     public void setPhoneNumber(String phoneNumber) {
USER         this.phoneNumber = phoneNumber;
USER     }
USER 
USER     public String getAddress() {
USER         return address;
USER     }
USER 
USER     public void setAddress(String address) {
USER         this.address = address;
USER     }
USER 
USER     public String getCategory() {
USER         return category;
USER     }
USER 
USER     public void setCategory(String category) {
USER         this.category = category;
USER     }
USER }
