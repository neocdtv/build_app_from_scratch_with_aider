ASSISTANT         if (query.contains(" ")) {
ASSISTANT             nameQuery = query.substring(0, query.indexOf(" "));
ASSISTANT         }
ASSISTANT         
ASSISTANT         List<Contact> byName = contactRepository.findByFirstNameOrLastNameContainingIgnoreCase(nameQuery);
ASSISTANT         List<Contact> byCategory = contactRepository.findByCategory(query);
ASSISTANT         
ASSISTANT         Set<Contact> combined = new HashSet<>(byName);
ASSISTANT         combined.addAll(byCategory);
ASSISTANT         return new ArrayList<>(combined);
