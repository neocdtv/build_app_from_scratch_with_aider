USER document.addEventListener('DOMContentLoaded', () => {
USER     const form = document.getElementById('contactForm');
USER     const searchInput = document.getElementById('searchInput');
USER     const tableBody = document.querySelector('#contactTable tbody');
USER     const toggleBtn = document.getElementById('toggleFormBtn');
USER     const cancelBtn = document.getElementById('cancelBtn');
USER 
USER     loadContacts();
USER 
USER     async function loadContacts(q = '') {
USER         const res = await fetch(`/api/contacts/search?q=${encodeURIComponent(q)}`);
USER         renderTable(await res.json());
USER     }
USER 
USER     function renderTable(contacts) {
USER         tableBody.innerHTML = '';
USER         contacts.forEach(c => {
USER             const tr = document.createElement('tr');
USER             tr.innerHTML = `
USER                 <td>${c.firstName} ${c.lastName}</td>
USER                 <td>${c.email}</td>
USER                 <td>${c.phoneNumber}</td>
USER                 <td>${c.category}</td>
USER                 <td class="actions">
USER                     <button class="edit-btn" data-id="${c.id}">Edit</button>
USER                     <button class="delete-btn" data-id="${c.id}">Delete</button>
USER                 </td>`;
USER             tableBody.appendChild(tr);
USER         });
USER     }
USER 
USER     form.addEventListener('submit', async (e) => {
USER         e.preventDefault();
USER         const id = document.getElementById('contactId').value;
USER         const payload = {
USER             firstName: document.getElementById('firstName').value.trim(),
USER             lastName: document.getElementById('lastName').value.trim(),
USER             email: document.getElementById('email').value.trim(),
USER             phoneNumber: document.getElementById('phoneNumber').value.trim(),
USER             address: document.getElementById('address').value.trim(),
USER             category: document.getElementById('category').value.trim()
USER         };
USER 
USER         if (!Object.values(payload).every(v => v)) {
USER             alert('All fields are required.'); return;
USER         }
USER 
USER         const url = id ? `/api/contacts/${id}` : '/api/contacts';
USER         await fetch(url, { method: id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
USER         form.reset(); document.getElementById('contactId').value = ''; toggleBtn.click(); loadContacts(searchInput.value);
USER     });
USER 
USER     searchInput.addEventListener('input', e => loadContacts(e.target.value));
USER     toggleBtn.addEventListener('click', () => { form.classList.toggle('active'); if (!form.classList.contains('active')) form.reset(); });
USER     cancelBtn.addEventListener('click', () => { form.classList.remove('active'); form.reset(); });
USER 
USER     tableBody.addEventListener('click', async (e) => {
USER         const id = e.target.dataset.id; if (!id) return;
USER         if (e.target.classList.contains('edit-btn')) {
USER             const c = await (await fetch(`/api/contacts/${id}`)).json();
USER             ['firstName','lastName','email','phoneNumber','address','category'].forEach(f => document.getElementById(f).value = c[f]);
USER             document.getElementById('contactId').value = c.id; form.classList.add('active');
USER         } else if (e.target.classList.contains('delete-btn')) {
USER             if (!confirm('Delete this contact?')) return;
USER             await fetch(`/api/contacts/${id}`, { method: 'DELETE' }); loadContacts(searchInput.value);
USER         }
USER     });
USER });
USER ```
