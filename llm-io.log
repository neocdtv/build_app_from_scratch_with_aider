ASSISTANT #### 6. `src/main/java/com/addressbook/service/ContactService.java`
ASSISTANT Implement the service layer for CRUD operations and searching.
ASSISTANT 
ASSISTANT ```java
ASSISTANT package com.addressbook.service;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.repository.ContactRepository;
ASSISTANT import jakarta.persistence.EntityNotFoundException;
ASSISTANT import org.springframework.stereotype.Service;
ASSISTANT 
ASSISTANT import java.util.List;
ASSISTANT import java.util.Optional;
ASSISTANT 
ASSISTANT @Service
ASSISTANT public class ContactService {
ASSISTANT 
ASSISTANT     private final ContactRepository contactRepository;
ASSISTANT 
ASSISTANT     public ContactService(ContactRepository contactRepository) {
ASSISTANT         this.contactRepository = contactRepository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> getAllContacts() {
ASSISTANT         return contactRepository.findAll();
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Optional<Contact> getContactById(Long id) {
ASSISTANT         return contactRepository.findById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact createContact(Contact contact) {
ASSISTANT         return contactRepository.save(contact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact updateContact(Long id, Contact updatedContact) {
ASSISTANT         Contact existingContact = contactRepository.findById(id)
ASSISTANT                 .orElseThrow(() -> new EntityNotFoundException("Contact with ID " + id + " not found"));
ASSISTANT         
ASSISTANT         existingContact.setFirstName(updatedContact.getFirstName());
ASSISTANT         existingContact.setLastName(updatedContact.getLastName());
ASSISTANT         existingContact.setEmail(updatedContact.getEmail());
ASSISTANT         existingContact.setPhoneNumber(updatedContact.getPhoneNumber());
ASSISTANT         existingContact.setAddress(updatedContact.getAddress());
ASSISTANT         existingContact.setCategory(updatedContact.getCategory());
ASSISTANT         
ASSISTANT         return contactRepository.save(existingContact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public void deleteContact(Long id) {
ASSISTANT         if (!contactRepository.existsById(id)) {
ASSISTANT             throw new EntityNotFoundException("Contact with ID " + id + " not found");
ASSISTANT         }
ASSISTANT         contactRepository.deleteById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> searchContacts(String query) {
ASSISTANT         return contactRepository.findByCategoryContainingIgnoreCaseOrLastNameContainingIgnoreCaseOrFirstNameContainingIgnoreCase(
ASSISTANT                 query, query, query);
ASSISTANT     }
ASSISTANT }
ASSISTANT ```
