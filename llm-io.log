ASSISTANT ### 10. `src/main/resources/static/app.js`
ASSISTANT Vanilla JS with Fetch API for all CRUD operations and client-side validation.
ASSISTANT ```javascript
ASSISTANT const API_BASE = '/api/contacts';
ASSISTANT let searchQuery = '';
ASSISTANT 
ASSISTANT document.addEventListener('DOMContentLoaded', loadContacts);
ASSISTANT 
ASSISTANT async function loadContacts() {
ASSISTANT     const query = searchQuery ? `?q=${encodeURIComponent(searchQuery)}` : '';
ASSISTANT     const res = await fetch(`${API_BASE}${query}`);
ASSISTANT     const contacts = await res.json();
ASSISTANT     renderTable(contacts);
ASSISTANT }
ASSISTANT 
ASSISTANT function renderTable(contacts) {
ASSISTANT     const tbody = document.getElementById('contactList');
ASSISTANT     tbody.innerHTML = '';
ASSISTANT     contacts.forEach(c => {
ASSISTANT         const tr = document.createElement('tr');
ASSISTANT         tr.innerHTML = `
ASSISTANT             <td>${c.firstName} ${c.lastName}</td>
ASSISTANT             <td>${c.email}</td>
ASSISTANT             <td>${c.phoneNumber}</td>
ASSISTANT             <td>${c.category}</td>
ASSISTANT             <td>
ASSISTANT                 <button class="edit-btn" onclick='editContact(${JSON.stringify(c)})'>Edit</button>
ASSISTANT                 <button class="delete-btn" onclick="deleteContact(${c.id})">Delete</button>
ASSISTANT             </td>
ASSISTANT         `;
ASSISTANT         tbody.appendChild(tr);
ASSISTANT     });
ASSISTANT }
ASSISTANT 
ASSISTANT async function handleFormSubmit(e) {
ASSISTANT     e.preventDefault();
ASSISTANT     const id = document.getElementById('contactId').value;
ASSISTANT     const data = {
ASSISTANT         firstName: document.getElementById('firstName').value,
ASSISTANT         lastName: document.getElementById('lastName').value,
