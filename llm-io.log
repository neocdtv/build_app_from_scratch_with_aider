USER src/main/java/com/addressbook/controller/ContactController.java
USER ````
USER package com.addressbook.controller;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.service.ContactService;
USER import jakarta.validation.Valid;
USER import org.springframework.http.HttpStatus;
USER import org.springframework.http.ResponseEntity;
USER import org.springframework.web.bind.annotation.*;
USER 
USER import java.util.List;
USER 
USER @RestController
USER @RequestMapping("/api/contacts")
USER @CrossOrigin // For development flexibility
USER public class ContactController {
USER     private final ContactService service;
USER 
USER     public ContactController(ContactService service) {
USER         this.service = service;
USER     }
USER 
USER     @GetMapping
USER     public List<Contact> getAll() {
USER         return service.getAllContacts();
USER     }
USER 
USER     @GetMapping("/{id}")
USER     public ResponseEntity<Contact> getById(@PathVariable Long id) {
USER         return ResponseEntity.ok(service.getContactById(id));
USER     }
USER 
USER     @PostMapping
USER     public ResponseEntity<Contact> create(@Valid @RequestBody Contact contact) {
USER         return new ResponseEntity<>(service.createContact(contact), HttpStatus.CREATED);
USER     }
USER 
USER     @PutMapping("/{id}")
USER     public ResponseEntity<Contact> update(@PathVariable Long id, @Valid @RequestBody Contact contact) {
USER         return ResponseEntity.ok(service.updateContact(id, contact));
USER     }
USER 
USER     @DeleteMapping("/{id}")
USER     @ResponseStatus(HttpStatus.NO_CONTENT)
USER     public void delete(@PathVariable Long id) {
USER         service.deleteContact(id);
USER     }
USER 
USER     @GetMapping("/search")
USER     public List<Contact> search(@RequestParam String q) {
USER         return service.searchContacts(q);
USER     }
USER }
USER ````
