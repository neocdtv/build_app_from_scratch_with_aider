USER package com.addressbook.controller;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.service.ContactService;
USER import jakarta.validation.Valid;
USER import org.springframework.http.HttpStatus;
USER import org.springframework.http.ResponseEntity;
USER import org.springframework.web.bind.annotation.*;
USER 
USER import java.util.List;
USER 
USER @RestController
USER @RequestMapping("/api/contacts")
USER @CrossOrigin("*")
USER public class ContactController {
USER     private final ContactService service;
USER 
USER     public ContactController(ContactService service) {
USER         this.service = service;
USER     }
USER 
USER     @GetMapping
USER     public List<Contact> getAll() { return service.getAllContacts(); }
USER 
USER     @GetMapping("/{id}")
USER     public Contact getById(@PathVariable Long id) { return service.getContactById(id); }
USER 
USER     @PostMapping
USER     @ResponseStatus(HttpStatus.CREATED)
USER     public Contact create(@Valid @RequestBody Contact contact) { return service.createContact(contact); }
USER 
USER     @PutMapping("/{id}")
USER     public Contact update(@PathVariable Long id, @Valid @RequestBody Contact contact) {
USER         return service.updateContact(id, contact);
USER     }
USER 
USER     @DeleteMapping("/{id}")
USER     @ResponseStatus(HttpStatus.NO_CONTENT)
USER     public void delete(@PathVariable Long id) { service.deleteContact(id); }
USER 
USER     @GetMapping("/search")
USER     public List<Contact> search(@RequestParam String q) { return service.searchContacts(q); }
USER }
USER ````
