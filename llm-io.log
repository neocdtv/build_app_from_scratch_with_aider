USER async function fetchContacts() {
USER     try {
USER         const response = await fetch('/api/contacts');
USER         if (!response.ok) throw new Error('Failed to fetch contacts');
USER         const contacts = await response.json();
USER         renderContacts(contacts);
USER     } catch (error) {
USER         console.error(error);
USER         alert('Error fetching contacts: ' + error.message);
USER     }
USER }
USER 
USER function renderContacts(contacts) {
USER     const tableBody = document.getElementById('contactsTableBody');
USER     tableBody.innerHTML = '';
USER 
USER     contacts.forEach(contact => {
USER         const row = document.createElement('tr');
USER         row.innerHTML = `
USER             <td>${contact.id}</td>
USER             <td>${escapeHtml(contact.firstName)}</td>
USER             <td>${escapeHtml(contact.lastName)}</td>
USER             <td>${escapeHtml(contact.email)}</td>
USER             <td>${escapeHtml(contact.phoneNumber)}</td>
USER             <td>${escapeHtml(contact.address)}</td>
USER             <td>${escapeHtml(contact.category)}</td>
USER             <td>
USER                 <button class="btn-edit" onclick="editContact(${contact.id})">Edit</button>
USER                 <button class="btn-delete" onclick="deleteContact(${contact.id})">Delete</button>
USER             </td>
USER         `;
USER         tableBody.appendChild(row);
USER     });
USER }
USER 
USER function escapeHtml(text) {
USER     if (text === null || text === undefined) return '';
USER     const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
USER     return String(text).replace(/[&<>"']/g, function(m) { return map[m]; });
USER }
