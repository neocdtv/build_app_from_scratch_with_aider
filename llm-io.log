USER ### 10. `src/main/resources/static/app.js`
USER Vanilla JS with Fetch API for all CRUD operations and client-side validation.
USER ```javascript
USER const API_BASE = '/api/contacts';
USER let searchQuery = '';
USER 
USER document.addEventListener('DOMContentLoaded', loadContacts);
USER 
USER async function loadContacts() {
USER     const query = searchQuery ? `?q=${encodeURIComponent(searchQuery)}` : '';
USER     const res = await fetch(`${API_BASE}${query}`);
USER     const contacts = await res.json();
USER     renderTable(contacts);
USER }
USER 
USER function renderTable(contacts) {
USER     const tbody = document.getElementById('contactList');
USER     tbody.innerHTML = '';
USER     contacts.forEach(c => {
USER         const tr = document.createElement('tr');
USER         tr.innerHTML = `
USER             <td>${c.firstName} ${c.lastName}</td>
USER             <td>${c.email}</td>
USER             <td>${c.phoneNumber}</td>
USER             <td>${c.category}</td>
USER             <td>
USER                 <button class="edit-btn" onclick='editContact(${JSON.stringify(c)})'>Edit</button>
USER                 <button class="delete-btn" onclick="deleteContact(${c.id})">Delete</button>
USER             </td>
USER         `;
USER         tbody.appendChild(tr);
USER     });
USER }
USER 
USER async function handleFormSubmit(e) {
USER     e.preventDefault();
USER     const id = document.getElementById('contactId').value;
USER     const data = {
USER         firstName: document.getElementById('firstName').value,
USER         lastName: document.getElementById('lastName').value,
USER         email: document.getElementById('email').value,
USER         phoneNumber: document.getElementById('phoneNumber').value,
USER         address: document.getElementById('address').value,
USER         category: document.getElementById('category').value
USER     };
USER 
USER     const method = id ? 'PUT' : 'POST';
USER     const url = id ? `${API_BASE}/${id}` : API_BASE;
USER 
USER     try {
USER         const res = await fetch(url, {
USER             method,
USER             headers: { 'Content-Type': 'application/json' },
USER             body: JSON.stringify(data)
USER         });
USER         if (!res.ok) throw new Error('Failed to save');
USER         resetForm();
USER         loadContacts();
USER     } catch (err) {
USER         alert(err.message);
USER     }
USER }
USER 
USER async function editContact(contact) {
USER     document.getElementById('contactId').value = contact.id;
USER     document.getElementById('firstName').value = contact.firstName;
USER     document.getElementById('lastName').value = contact.lastName;
USER     document.getElementById('email').value = contact.email;
USER     document.getElementById('phoneNumber').value = contact.phoneNumber;
USER     document.getElementById('address').value = contact.address;
USER     document.getElementById('category').value = contact.category;
USER     document.getElementById('formTitle').textContent = 'Edit Contact';
USER     document.getElementById('submitBtn').textContent = 'Update';
USER }
USER 
USER async function deleteContact(id) {
USER     if (!confirm('Delete this contact?')) return;
USER     const res = await fetch(`${API_BASE}/${id}`, { method: 'DELETE' });
USER     if (res.ok) loadContacts();
USER     else alert('Failed to delete');
USER }
USER 
USER function resetForm() {
USER     document.getElementById('contactForm').reset();
USER     document.getElementById('contactId').value = '';
USER     document.getElementById('formTitle').textContent = 'Add Contact';
USER     document.getElementById('submitBtn').textContent = 'Save';
USER }
USER 
USER document.getElementById('searchInput').addEventListener('input', (e) => {
USER     searchQuery = e.target.value;
USER     loadContacts();
USER });
USER ```
