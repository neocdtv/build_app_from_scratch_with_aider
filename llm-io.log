USER ### `src/main/resources/static/js/app.js`
USER ```javascript
USER document.addEventListener('DOMContentLoaded', () => {
USER     const API_URL = '/api/contacts';
USER     
USER     const searchInput = document.getElementById('searchInput');
USER     const searchBtn = document.getElementById('searchBtn');
USER     const addContactBtn = document.getElementById('addContactBtn');
USER     const contactList = document.getElementById('contactList');
USER     const dialog = document.getElementById('contactDialog');
USER     const form = document.getElementById('contactForm');
USER     const closeDialogBtn = document.getElementById('closeDialogBtn');
USER     const formTitle = document.getElementById('formTitle');
USER 
USER     loadContacts();
USER 
USER     searchBtn.addEventListener('click', () => loadContacts(searchInput.value));
USER     addContactBtn.addEventListener('click', openForm);
USER     closeDialogBtn.addEventListener('click', () => dialog.close());
USER     form.addEventListener('submit', saveContact);
USER 
USER     async function loadContacts(query = '') {
USER         contactList.innerHTML = '<p>Loading...</p>';
USER         try {
USER             let url = query ? `${API_URL}/search?q=${encodeURIComponent(query)}` : API_URL;
USER             const response = await fetch(url);
USER             if (!response.ok) throw new Error('Failed to fetch contacts');
USER             
USER             const contacts = await response.json();
USER             renderContacts(contacts);
USER         } catch (error) {
USER             contactList.innerHTML = `<p style="color: red;">Error loading contacts: ${error.message}</p>`;
USER         }
USER     }
USER 
USER     function renderContacts(contacts) {
USER         if (contacts.length === 0) {
USER             contactList.innerHTML = '<p>No contacts found.</p>';
USER             return;
USER         }
USER 
USER         contactList.innerHTML = '';
USER         contacts.forEach(contact => {
USER             const card = document.createElement('div');
USER             card.className = 'contact-card';
USER             card.dataset.id = contact.id;
USER             card.innerHTML = `
USER                 <span class="contact-category">${escapeHtml(contact.category)}</span>
USER                 <h3>${escapeHtml(contact.firstName)} ${escapeHtml(contact.lastName)}</h3>
USER                 <p><strong>Email:</strong> ${escapeHtml(contact.email)}</p>
USER                 <p><strong>Phone:</strong> ${escapeHtml(contact.phoneNumber)}</p>
USER                 <p><strong>Address:</strong> ${escapeHtml(contact.address)}</p>
USER                 <div class="card-actions">
USER                     <button class="btn-edit">Edit</button>
USER                     <button class="btn-delete">Delete</button>
USER                 </div>
USER             `;
USER             contactList.appendChild(card);
USER         });
USER 
USER         document.querySelectorAll('.btn-edit').forEach(btn => {
USER             btn.addEventListener('click', (e) => editContact(e.target.closest('.contact-card').dataset.id));
USER         });
USER         document.querySelectorAll('.btn-delete').forEach(btn => {
USER             btn.addEventListener('click', (e) => deleteContact(e.target.closest('.contact-card').dataset.id));
USER         });
USER     }
USER 
USER     function openForm(contact = null) {
USER         form.reset();
USER         document.getElementById('contactId').value = '';
USER         
USER         if (contact) {
USER             formTitle.textContent = 'Edit Contact';
USER             document.getElementById('contactId').value = contact.id;
USER             document.getElementById('firstName').value = contact.firstName;
USER             document.getElementById('lastName').value = contact.lastName;
USER             document.getElementById('email').value = contact.email;
USER             document.getElementById('phoneNumber').value = contact.phoneNumber;
USER             document.getElementById('address').value = contact.address;
USER             document.getElementById('category').value = contact.category;
USER         } else {
USER             formTitle.textContent = 'Add Contact';
USER         }
USER         dialog.showModal();
USER     }
USER 
USER     async function editContact(id) {
USER         try {
USER             const response = await fetch(`${API_URL}/${id}`);
USER             if (!response.ok) throw new Error('Contact not found');
USER             openForm(await response.json());
USER         } catch (error) {
USER             alert(error.message);
USER         }
USER     }
USER 
USER     async function deleteContact(id) {
USER         if (!confirm('Are you sure you want to delete this contact?')) return;
USER         try {
USER             const response = await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
USER             if (!response.ok) throw new Error('Failed to delete contact');
USER             loadContacts(searchInput.value);
USER         } catch (error) {
USER             alert(error.message);
USER         }
USER     }
USER 
USER     async function saveContact(e) {
USER         e.preventDefault();
USER         const id = document.getElementById('contactId').value;
USER         const method = id ? 'PUT' : 'POST';
USER         const url = id ? `${API_URL}/${id}` : API_URL;
USER 
USER         const contactData = {
USER             firstName: document.getElementById('firstName').value,
USER             lastName: document.getElementById('lastName').value,
USER             email: document.getElementById('email').value,
USER             phoneNumber: document.getElementById('phoneNumber').value,
USER             address: document.getElementById('address').value,
USER             category: document.getElementById('category').value
USER         };
USER 
USER         if (!Object.values(contactData).every(v => v.trim() !== '')) {
USER             alert('Please fill in all fields correctly.');
USER             return;
USER         }
USER 
USER         try {
USER             const response = await fetch(url, {
USER                 method: method,
USER                 headers: { 'Content-Type': 'application/json' },
USER                 body: JSON.stringify(contactData)
USER             });
USER 
USER             if (!response.ok) throw new Error('Failed to save contact');
USER             dialog.close();
USER             loadContacts(searchInput.value);
USER         } catch (error) {
USER             alert(error.message);
USER         }
USER     }
USER 
USER     function escapeHtml(text) {
USER         const div = document.createElement('div');
USER         div.textContent = text;
USER         return div.innerHTML;
USER     }
USER });
USER ```
