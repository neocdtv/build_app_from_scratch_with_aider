ASSISTANT 
ASSISTANT     public ContactService(ContactRepository repository) {
ASSISTANT         this.repository = repository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> findAll() {
ASSISTANT         return repository.findAll();
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact findById(Long id) {
ASSISTANT         return repository.findById(id)
ASSISTANT                 .orElseThrow(() -> new NoSuchElementException("Contact not found with id: " + id));
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact create(Contact contact) {
ASSISTANT         return repository.save(contact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact update(Long id, Contact updatedContact) {
ASSISTANT         Contact existing = findById(id);
ASSISTANT         existing.setFirstName(updatedContact.getFirstName());
ASSISTANT         existing.setLastName(updatedContact.getLastName());
ASSISTANT         existing.setEmail(updatedContact.getEmail());
ASSISTANT         existing.setPhoneNumber(updatedContact.getPhoneNumber());
ASSISTANT         existing.setAddress(updatedContact.getAddress());
ASSISTANT         existing.setCategory(updatedContact.getCategory());
ASSISTANT         return repository.save(existing);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public void delete(Long id) {
ASSISTANT         findById(id);
ASSISTANT         repository.deleteById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> search(String query) {
ASSISTANT         String q = (query != null && !query.isBlank()) ? query.trim() : "";
