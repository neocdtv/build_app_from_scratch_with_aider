USER #### 6. `src/main/java/com/addressbook/service/ContactService.java`
USER Implement the service layer for CRUD operations and searching.
USER 
USER ```java
USER package com.addressbook.service;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import jakarta.persistence.EntityNotFoundException;
USER import org.springframework.stereotype.Service;
USER 
USER import java.util.List;
USER import java.util.Optional;
USER 
USER @Service
USER public class ContactService {
USER 
USER     private final ContactRepository contactRepository;
USER 
USER     public ContactService(ContactRepository contactRepository) {
USER         this.contactRepository = contactRepository;
USER     }
USER 
USER     public List<Contact> getAllContacts() {
USER         return contactRepository.findAll();
USER     }
USER 
USER     public Optional<Contact> getContactById(Long id) {
USER         return contactRepository.findById(id);
USER     }
USER 
USER     public Contact createContact(Contact contact) {
USER         return contactRepository.save(contact);
USER     }
USER 
USER     public Contact updateContact(Long id, Contact updatedContact) {
USER         Contact existingContact = contactRepository.findById(id)
USER                 .orElseThrow(() -> new EntityNotFoundException("Contact with ID " + id + " not found"));
USER         
USER         existingContact.setFirstName(updatedContact.getFirstName());
USER         existingContact.setLastName(updatedContact.getLastName());
USER         existingContact.setEmail(updatedContact.getEmail());
USER         existingContact.setPhoneNumber(updatedContact.getPhoneNumber());
USER         existingContact.setAddress(updatedContact.getAddress());
USER         existingContact.setCategory(updatedContact.getCategory());
USER         
USER         return contactRepository.save(existingContact);
USER     }
USER 
USER     public void deleteContact(Long id) {
USER         if (!contactRepository.existsById(id)) {
USER             throw new EntityNotFoundException("Contact with ID " + id + " not found");
USER         }
USER         contactRepository.deleteById(id);
USER     }
USER 
USER     public List<Contact> searchContacts(String query) {
USER         return contactRepository.findByCategoryContainingIgnoreCaseOrLastNameContainingIgnoreCaseOrFirstNameContainingIgnoreCase(
USER                 query, query, query);
USER     }
USER }
USER ```
