USER ### 11. `src/main/resources/static/app.js`
USER ```javascript
USER const API_BASE = '/api/contacts';
USER const form = document.getElementById('contactForm');
USER const contactList = document.getElementById('contactList');
USER const searchInput = document.getElementById('searchInput');
USER const searchBtn = document.getElementById('searchBtn');
USER 
USER let editingId = null;
USER 
USER document.addEventListener('DOMContentLoaded', () => fetchContacts());
USER searchBtn.addEventListener('click', handleSearch);
USER 
USER async function fetchContacts() {
USER     try {
USER         const res = await fetch(API_BASE);
USER         const contacts = await res.json();
USER         renderContacts(contacts);
USER     } catch (err) console.error('Failed to load contacts:', err);
USER }
USER 
USER async function handleSearch() {
USER     const query = searchInput.value.trim();
USER     if (!query) return fetchContacts();
USER     try {
USER         const res = await fetch(`${API_BASE}/search?q=${encodeURIComponent(query)}`);
USER         renderContacts(await res.json());
USER     } catch (err) console.error('Search failed:', err);
USER }
USER 
USER function renderContacts(contacts) {
USER     contactList.innerHTML = '';
USER     contacts.forEach(c => {
USER         const tr = document.createElement('tr');
USER         tr.innerHTML = `
USER             <td>${c.firstName} ${c.lastName}</td>
USER             <td>${c.email}</td>
USER             <td>${c.phoneNumber}</td>
USER             <td>${c.address}</td>
USER             <td>${c.category}</td>
USER             <td>
USER                 <button class="action-btn edit-btn" onclick="editContact(${c.id})">Edit</button>
USER                 <button class="action-btn delete-btn" onclick="deleteContact(${c.id})">Delete</button>
USER             </td>`;
USER         contactList.appendChild(tr);
USER     });
USER }
USER 
USER form.addEventListener('submit', async (e) => {
USER     e.preventDefault();
USER     const data = {
USER         firstName: document.getElementById('firstName').value,
USER         lastName: document.getElementById('lastName').value,
USER         email: document.getElementById('email').value,
USER         phoneNumber: document.getElementById('phoneNumber').value,
USER         address: document.getElementById('address').value,
USER         category: document.getElementById('category').value
USER     };
USER 
USER     // Client-side validation refinement
USER     const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
USER     if (!emailRegex.test(data.email)) { alert('Invalid email format'); return; }
USER 
USER     try {
USER         const method = editingId ? 'PUT' : 'POST';
USER         const url = editingId ? `${API_BASE}/${editingId}` : API_BASE;
USER         await fetch(url, {
USER             method,
USER             headers: { 'Content-Type': 'application/json' },
USER             body: JSON.stringify(data)
USER         });
USER         resetForm();
USER         fetchContacts();
USER     } catch (err) console.error('Save failed:', err);
USER });
USER 
USER async function editContact(id) {
USER     try {
USER         const res = await fetch(`${API_BASE}/${id}`);
USER         const c = await res.json();
USER         editingId = id;
USER         document.getElementById('contactId').value = c.id;
USER         document.getElementById('firstName').value = c.firstName;
USER         document.getElementById('lastName').value = c.lastName;
USER         document.getElementById('email').value = c.email;
USER         document.getElementById('phoneNumber').value = c.phoneNumber;
USER         document.getElementById('address').value = c.address;
USER         document.getElementById('category').value = c.category;
USER         document.getElementById('formTitle').textContent = 'Edit Contact';
USER         document.getElementById('submitBtn').textContent = 'Update';
USER         document.getElementById('cancelBtn').style.display = 'inline-block';
USER     } catch (err) console.error('Load edit failed:', err);
USER }
USER 
USER document.getElementById('cancelBtn').addEventListener('click', resetForm);
USER 
USER function resetForm() {
USER     editingId = null;
USER     form.reset();
USER     document.getElementById('formTitle').textContent = 'Add Contact';
USER     document.getElementById('submitBtn').textContent = 'Save';
USER     document.getElementById('cancelBtn').style.display = 'none';
USER }
USER 
USER async function deleteContact(id) {
USER     if (!confirm('Are you sure you want to delete this contact?')) return;
USER     try {
USER         await fetch(`${API_BASE}/${id}`, { method: 'DELETE' });
USER         fetchContacts();
USER     } catch (err) console.error('Delete failed:', err);
USER }
USER ```
