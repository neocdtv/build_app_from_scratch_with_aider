ASSISTANT `src/main/resources/static/app.js`
ASSISTANT Fetch API for CRUD operations, client-side validation.
ASSISTANT ```javascript
ASSISTANT document.addEventListener('DOMContentLoaded', () => {
ASSISTANT     fetchContacts();
ASSISTANT });
ASSISTANT 
ASSISTANT async function fetchContacts() {
ASSISTANT     try {
ASSISTANT         const response = await fetch('/api/contacts');
ASSISTANT         if (!response.ok) throw new Error('Failed to fetch contacts');
ASSISTANT         const contacts = await response.json();
ASSISTANT         renderContacts(contacts);
ASSISTANT     } catch (error) {
ASSISTANT         console.error(error);
ASSISTANT         alert('Error fetching contacts: ' + error.message);
ASSISTANT     }
ASSISTANT }
