ASSISTANT 
ASSISTANT @Repository
ASSISTANT public interface ContactRepository extends JpaRepository<Contact, Long> {
ASSISTANT 
ASSISTANT     // Search by name or category (case-insensitive)
ASSISTANT     List<Contact> findByCategoryContainingIgnoreCaseOrLastNameContainingIgnoreCaseOrFirstNameContainingIgnoreCase(
ASSISTANT             String category, String lastName, String firstName);
