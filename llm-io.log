USER ```javascript
USER const API_URL = '/api/contacts';
USER let contacts = [];
USER 
USER document.addEventListener('DOMContentLoaded', () => {
USER     fetchContacts();
USER     document.getElementById('searchInput').addEventListener('input', handleSearch);
USER     document.getElementById('addBtn').addEventListener('click', openForm);
USER     document.getElementById('cancelBtn').addEventListener('click', closeForm);
USER     document.getElementById('contactForm').addEventListener('submit', handleSubmit);
USER });
USER 
USER async function fetchContacts(query = '') {
USER     const res = await fetch(`${API_URL}${query ? `/search?q=${encodeURIComponent(query)}` : ''}`);
USER     contacts = await res.json();
USER     renderTable(contacts);
USER }
USER 
USER function renderTable(data) {
USER     const tbody = document.getElementById('contactBody');
USER     const noData = document.getElementById('noData');
USER     tbody.innerHTML = '';
USER     
USER     if (data.length === 0) {
USER         noData.classList.remove('hidden');
USER         return;
USER     }
USER     noData.classList.add('hidden');
USER 
USER     data.forEach(c => {
USER         const tr = document.createElement('tr');
USER         tr.innerHTML = `
USER             <td>${c.firstName} ${c.lastName}</td>
USER             <td>${c.email}</td>
USER             <td>${c.phoneNumber}</td>
USER             <td>${c.address}</td>
USER             <td><span class="category">${c.category}</span></td>
USER             <td>
USER                 <button class="edit-btn" onclick="editContact(${c.id})">Edit</button>
USER                 <button class="delete-btn" onclick="deleteContact(${c.id})">Delete</button>
USER             </td>
USER         `;
USER         tbody.appendChild(tr);
USER     });
USER }
USER 
USER function openForm() {
USER     document.getElementById('formTitle').textContent = 'Add Contact';
USER     document.getElementById('submitBtn').textContent = 'Save';
USER     document.getElementById('contactId').value = '';
USER     document.getElementById('contactForm').reset();
USER     document.getElementById('formContainer').classList.remove('hidden');
USER }
USER 
USER function closeForm() {
USER     document.getElementById('formContainer').classList.add('hidden');
USER }
USER 
USER async function editContact(id) {
USER     const res = await fetch(`${API_URL}/${id}`);
USER     const contact = await res.json();
USER     
USER     document.getElementById('contactId').value = contact.id;
USER     document.getElementById('firstName').value = contact.firstName;
USER     document.getElementById('lastName').value = contact.lastName;
USER     document.getElementById('email').value = contact.email;
USER     document.getElementById('phoneNumber').value = contact.phoneNumber;
USER     document.getElementById('address').value = contact.address;
USER     document.getElementById('category').value = contact.category;
USER     
USER     document.getElementById('formTitle').textContent = 'Edit Contact';
USER     document.getElementById('submitBtn').textContent = 'Update';
USER     document.getElementById('formContainer').classList.remove('hidden');
USER }
USER 
USER async function handleSubmit(e) {
USER     e.preventDefault();
USER     
USER     const id = document.getElementById('contactId').value;
USER     const payload = {
USER         firstName: document.getElementById('firstName').value.trim(),
USER         lastName: document.getElementById('lastName').value.trim(),
USER         email: document.getElementById('email').value.trim(),
USER         phoneNumber: document.getElementById('phoneNumber').value.trim(),
USER         address: document.getElementById('address').value.trim(),
USER         category: document.getElementById('category').value.trim()
USER     };
USER 
USER     try {
USER         const method = id ? 'PUT' : 'POST';
USER         const url = id ? `${API_URL}/${id}` : API_URL;
USER         
USER         const res = await fetch(url, {
USER             method,
USER             headers: { 'Content-Type': 'application/json' },
USER             body: JSON.stringify(payload)
USER         });
USER 
USER         if (!res.ok) {
USER             const errors = await res.json();
USER             alert('Validation Error: ' + Object.values(errors).join(', '));
USER             return;
USER         }
USER 
USER         closeForm();
USER         await fetchContacts(document.getElementById('searchInput').value);
USER     } catch (err) {
USER         alert('Network error');
USER     }
USER }
USER 
USER async function deleteContact(id) {
USER     if (!confirm('Are you sure you want to delete this contact?')) return;
USER     
USER     const res = await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
USER     if (res.status === 204) {
USER         await fetchContacts(document.getElementById('searchInput').value);
USER     } else {
USER         alert('Failed to delete contact');
USER     }
USER }
USER 
USER function handleSearch(e) {
USER     const query = e.target.value.trim();
USER     fetchContacts(query);
USER }
USER ```
