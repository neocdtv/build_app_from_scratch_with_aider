ASSISTANT     const url = id ? `${API_BASE}/${id}` : API_BASE;
ASSISTANT 
ASSISTANT     try {
ASSISTANT         const res = await fetch(url, {
ASSISTANT             method,
ASSISTANT             headers: { 'Content-Type': 'application/json' },
ASSISTANT             body: JSON.stringify(data)
ASSISTANT         });
ASSISTANT         if (!res.ok) throw new Error('Failed to save');
ASSISTANT         resetForm();
ASSISTANT         loadContacts();
ASSISTANT     } catch (err) {
ASSISTANT         alert(err.message);
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT async function editContact(contact) {
ASSISTANT     document.getElementById('contactId').value = contact.id;
ASSISTANT     document.getElementById('firstName').value = contact.firstName;
ASSISTANT     document.getElementById('lastName').value = contact.lastName;
ASSISTANT     document.getElementById('email').value = contact.email;
ASSISTANT     document.getElementById('phoneNumber').value = contact.phoneNumber;
ASSISTANT     document.getElementById('address').value = contact.address;
ASSISTANT     document.getElementById('category').value = contact.category;
ASSISTANT     document.getElementById('formTitle').textContent = 'Edit Contact';
ASSISTANT     document.getElementById('submitBtn').textContent = 'Update';
ASSISTANT }
ASSISTANT 
ASSISTANT async function deleteContact(id) {
ASSISTANT     if (!confirm('Delete this contact?')) return;
