USER package com.addressbook.service;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import org.springframework.stereotype.Service;
USER import java.util.List;
USER 
USER @Service
USER public class ContactService {
USER     private final ContactRepository repository;
USER 
USER     public ContactService(ContactRepository repository) {
USER         this.repository = repository;
USER     }
USER 
USER     public List<Contact> getAllContacts() {
USER         return repository.findAll();
USER     }
USER 
USER     public Contact getContactById(Long id) {
USER         return repository.findById(id).orElseThrow(() -> new RuntimeException("Contact not found"));
USER     }
USER 
USER     public Contact createContact(Contact contact) {
USER         return repository.save(contact);
USER     }
USER 
USER     public Contact updateContact(Long id, Contact contactDetails) {
USER         Contact contact = getContactById(id);
USER         contact.setFirstName(contactDetails.getFirstName());
USER         contact.setLastName(contactDetails.getLastName());
USER         contact.setEmail(contactDetails.getEmail());
USER         contact.setPhoneNumber(contactDetails.getPhoneNumber());
USER         contact.setAddress(contactDetails.getAddress());
USER         contact.setCategory(contactDetails.getCategory());
USER         return repository.save(contact);
USER     }
USER 
USER     public void deleteContact(Long id) {
USER         repository.deleteById(id);
USER     }
USER 
USER     public List<Contact> searchContacts(String query) {
USER         return repository.findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCaseOrCategoryContainingIgnoreCase(
USER                 query, query, query);
USER     }
USER }
USER ```
