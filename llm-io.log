ASSISTANT **5. src/main/java/com/addressbook/service/ContactService.java**
ASSISTANT ```java
ASSISTANT package com.addressbook.service;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.repository.ContactRepository;
ASSISTANT import org.springframework.stereotype.Service;
ASSISTANT import org.springframework.transaction.annotation.Transactional;
ASSISTANT 
ASSISTANT import java.util.List;
ASSISTANT import java.util.Optional;
ASSISTANT 
ASSISTANT @Service
ASSISTANT @Transactional
ASSISTANT public class ContactService {
ASSISTANT 
ASSISTANT     private final ContactRepository contactRepository;
ASSISTANT 
ASSISTANT     public ContactService(ContactRepository contactRepository) {
ASSISTANT         this.contactRepository = contactRepository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> findAll() {
ASSISTANT         return contactRepository.findAll();
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Optional<Contact> findById(Long id) {
ASSISTANT         return contactRepository.findById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact create(Contact contact) {
ASSISTANT         return contactRepository.save(contact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact update(Long id, Contact contact) {
ASSISTANT         if (contact.getId() != null && !contact.getId().equals(id)) {
ASSISTANT             throw new IllegalArgumentException("ID mismatch");
ASSISTANT         }
ASSISTANT         contact.setId(id);
ASSISTANT         return contactRepository.save(contact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public void delete(Long id) {
ASSISTANT         contactRepository.deleteById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> searchByQuery(String query) {
ASSISTANT         if (query == null || query.trim().isEmpty()) {
ASSISTANT             return findAll();
ASSISTANT         }
ASSISTANT         String[] parts = query.split(" ");
ASSISTANT         List<Contact> byFirstName = contactRepository.findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCase(parts[0], parts[0]);
ASSISTANT 
ASSISTANT         // Search by category
ASSISTANT         List<Contact> byCategory = contactRepository.findAll().stream()
ASSISTANT                 .filter(c -> c.getCategory().equalsIgnoreCase(query))
ASSISTANT                 .toList();
ASSISTANT 
ASSISTANT         // Combine and remove duplicates
ASSISTANT         return StreamSupport.stream(Stream.of(byFirstName, byCategory).spliterator(), false)
ASSISTANT                 .distinct()
ASSISTANT                 .toList();
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> searchByCategory(String category) {
ASSISTANT         return contactRepository.findAll().stream()
ASSISTANT                 .filter(c -> c.getCategory().equalsIgnoreCase(category))
ASSISTANT                 .toList();
ASSISTANT     }
ASSISTANT }
ASSISTANT ```
ASSISTANT Wait, the `searchByQuery` implementation is a bit clunky. Let's use Spring Data JPA's standard search capabilities.
ASSISTANT ```java
ASSISTANT import org.springframework.data.jpa.repository.Query;
ASSISTANT 
ASSISTANT public interface ContactRepository extends JpaRepository<Contact, Long> {
ASSISTANT 
ASSISTANT     @Query("SELECT c FROM Contact c WHERE c.firstName LIKE %?1% OR c.lastName LIKE %?1%")
ASSISTANT     List<Contact> findByFirstNameOrLastNameContainingIgnoreCase(String keyword);
ASSISTANT 
ASSISTANT     @Query("SELECT c FROM Contact c WHERE c.category = ?1")
ASSISTANT     List<Contact> findByCategory(String category);
ASSISTANT }
ASSISTANT ```
ASSISTANT Then in Service:
ASSISTANT ```java
ASSISTANT     public List<Contact> searchByQuery(String query) {
ASSISTANT         if (query == null || query.trim().isEmpty()) {
ASSISTANT             return findAll();
ASSISTANT         }
ASSISTANT         String[] parts = query.split(" ");
ASSISTANT         List<Contact> byName = contactRepository.findByFirstNameOrLastNameContainingIgnoreCase(parts[0]);
ASSISTANT         List<Contact> byCategory = contactRepository.findByCategory(query);
ASSISTANT         
ASSISTANT         Set<Contact> combined = new HashSet<>(byName);
ASSISTANT         combined.addAll(byCategory);
ASSISTANT         return new ArrayList<>(combined);
ASSISTANT     }
ASSISTANT ```
