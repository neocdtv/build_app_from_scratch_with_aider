USER import jakarta.persistence.*;
USER import jakarta.validation.constraints.*;
USER 
USER @Entity
USER public class Contact {
USER     @Id
USER     @GeneratedValue(strategy = GenerationType.IDENTITY)
USER     private Long id;
USER 
USER     @NotBlank @Size(max = 50)
USER     private String firstName;
USER 
USER     @NotBlank @Size(max = 50)
USER     private String lastName;
USER 
USER     @NotBlank @Email @Size(max = 100)
USER     private String email;
USER 
USER     @NotBlank @Size(max = 20)
USER     private String phoneNumber;
USER 
USER     @NotBlank @Size(max = 255)
USER     private String address;
USER 
USER     @NotBlank @Size(max = 50)
USER     private String category;
USER 
USER     // Constructors
USER     public Contact() {}
USER 
USER     public Contact(String firstName, String lastName, String email, String phoneNumber, String address, String category) {
USER         this.firstName = firstName;
USER         this.lastName = lastName;
USER         this.email = email;
USER         this.phoneNumber = phoneNumber;
USER         this.address = address;
USER         this.category = category;
USER     }
USER 
USER     // Getters and Setters
USER     public Long getId() { return id; }
USER     public void setId(Long id) { this.id = id; }
USER     public String getFirstName() { return firstName; }
USER     public void setFirstName(String firstName) { this.firstName = firstName; }
USER     public String getLastName() { return lastName; }
USER     public void setLastName(String lastName) { this.lastName = lastName; }
USER     public String getEmail() { return email; }
USER     public void setEmail(String email) { this.email = email; }
USER     public String getPhoneNumber() { return phoneNumber; }
USER     public void setPhoneNumber(String phoneNumber) { this.phoneNumber = phoneNumber; }
USER     public String getAddress() { return address; }
USER     public void setAddress(String address) { this.address = address; }
USER     public String getCategory() { return category; }
USER     public void setCategory(String category) { this.category = category; }
USER }
