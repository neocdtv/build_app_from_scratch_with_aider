USER ### 4. Controller Layer
USER 
USER #### `src/main/java/com/addressbook/controller/ContactController.java`
USER REST Controller handling HTTP requests.
USER 
USER ```java
USER package com.addressbook.controller;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.service.ContactService;
USER import jakarta.persistence.EntityNotFoundException;
USER import jakarta.validation.Valid;
USER import org.springframework.beans.factory.annotation.Autowired;
USER import org.springframework.http.HttpStatus;
USER import org.springframework.http.ResponseEntity;
USER import org.springframework.web.bind.annotation.*;
USER import java.util.List;
USER 
USER @RestController
USER @RequestMapping("/api/contacts")
USER public class ContactController {
USER 
USER     private final ContactService contactService;
USER 
USER     @Autowired
USER     public ContactController(ContactService contactService) {
USER         this.contactService = contactService;
USER     }
USER 
USER     // GET /api/contacts - List all contacts
USER     @GetMapping
USER     public ResponseEntity<List<Contact>> getAllContacts() {
USER         return ResponseEntity.ok(contactService.getAllContacts());
USER     }
USER 
USER     // GET /api/contacts/{id} - Get single contact by ID
USER     @GetMapping("/{id}")
USER     public ResponseEntity<Contact> getContactById(@PathVariable Long id) {
USER         return contactService.getContactById(id)
USER                 .map(ResponseEntity::ok)
USER                 .orElse(ResponseEntity.notFound().build());
USER     }
USER 
USER     // POST /api/contacts - Create new contact
USER     @PostMapping
USER     public ResponseEntity<Contact> createContact(@Valid @RequestBody Contact contact) {
USER         Contact created = contactService.createContact(contact);
USER         return new ResponseEntity<>(created, HttpStatus.CREATED);
USER     }
USER 
USER     // PUT /api/contacts/{id} - Update existing contact
USER     @PutMapping("/{id}")
USER     public ResponseEntity<Contact> updateContact(@PathVariable Long id, @Valid @RequestBody Contact contact) {
USER         try {
USER             Contact updated = contactService.updateContact(id, contact);
USER             return ResponseEntity.ok(updated);
USER         } catch (EntityNotFoundException e) {
USER             return ResponseEntity.notFound().build();
USER         }
USER     }
USER 
USER     // DELETE /api/contacts/{id} - Delete contact by ID
USER     @DeleteMapping("/{id}")
USER     public ResponseEntity<Void> deleteContact(@PathVariable Long id) {
USER         try {
USER             contactService.deleteContact(id);
USER             return ResponseEntity.noContent().build();
USER         } catch (EntityNotFoundException e) {
USER             return ResponseEntity.notFound().build();
USER         }
USER     }
USER 
USER     // GET /api/contacts/search?q={query} - Search/filter by name or category
USER     @GetMapping("/search")
USER     public ResponseEntity<List<Contact>> searchContacts(@RequestParam String q) {
USER         List<Contact> results = contactService.searchContacts(q);
USER         return ResponseEntity.ok(results);
USER     }
USER }
USER ```
