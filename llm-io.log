USER src/main/java/com/addressbook/controller/ContactController.java
USER ````
USER package com.addressbook.controller;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.service.ContactService;
USER import jakarta.validation.Valid;
USER import org.springframework.http.HttpStatus;
USER import org.springframework.http.ResponseEntity;
USER import org.springframework.web.bind.annotation.*;
USER 
USER import java.util.List;
USER 
USER @RestController
USER @RequestMapping("/api/contacts")
USER public class ContactController {
USER 
USER     private final ContactService contactService;
USER 
USER     public ContactController(ContactService contactService) {
USER         this.contactService = contactService;
USER     }
USER 
USER     @GetMapping
USER     public List<Contact> getAllContacts() {
USER         return contactService.getAllContacts();
USER     }
USER 
USER     @GetMapping("/{id}")
USER     public ResponseEntity<Contact> getContactById(@PathVariable Long id) {
USER         Contact contact = contactService.getContactById(id);
USER         return contact != null ? ResponseEntity.ok(contact) : ResponseEntity.notFound().build();
USER     }
USER 
USER     @PostMapping
USER     public ResponseEntity<Contact> createContact(@Valid @RequestBody Contact contact) {
USER         Contact saved = contactService.createContact(contact);
USER         return ResponseEntity.status(HttpStatus.CREATED).body(saved);
USER     }
USER 
USER     @PutMapping("/{id}")
USER     public ResponseEntity<Contact> updateContact(@PathVariable Long id, @Valid @RequestBody Contact contact) {
USER         Contact updated = contactService.updateContact(id, contact);
USER         return updated != null ? ResponseEntity.ok(updated) : ResponseEntity.notFound().build();
USER     }
USER 
USER     @DeleteMapping("/{id}")
USER     public ResponseEntity<Void> deleteContact(@PathVariable Long id) {
USER         boolean deleted = contactService.deleteContact(id);
USER         return deleted ? ResponseEntity.noContent().build() : ResponseEntity.notFound().build();
USER     }
USER 
USER     @GetMapping("/search")
USER     public List<Contact> searchContacts(@RequestParam String q) {
USER         return contactService.searchContacts(q);
USER     }
USER }
