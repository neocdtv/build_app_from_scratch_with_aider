ASSISTANT     public ContactController(ContactService service) { this.service = service; }
ASSISTANT 
ASSISTANT     @GetMapping
ASSISTANT     public List<Contact> getAll() { return service.findAll(); }
ASSISTANT 
ASSISTANT     @GetMapping("/{id}")
ASSISTANT     public ResponseEntity<Contact> getById(@PathVariable Long id) {
ASSISTANT         return service.findById(id).map(ResponseEntity::ok).orElse(ResponseEntity.notFound().build());
ASSISTANT     }
ASSISTANT 
ASSISTANT     @PostMapping
ASSISTANT     public ResponseEntity<Contact> create(@Valid @RequestBody Contact contact) {
ASSISTANT         Contact created = service.create(contact);
ASSISTANT         return ResponseEntity.created(URI.create("/api/contacts/" + created.getId())).body(created);
ASSISTANT     }
ASSISTANT 
ASSISTANT     @PutMapping("/{id}")
ASSISTANT     public ResponseEntity<Contact> update(@PathVariable Long id, @Valid @RequestBody Contact contact) {
ASSISTANT         if (!service.findById(id).isPresent()) return ResponseEntity.notFound().build();
ASSISTANT         contact.setId(id);
ASSISTANT         return ResponseEntity.ok(service.update(contact));
ASSISTANT     }
ASSISTANT 
ASSISTANT     @DeleteMapping("/{id}")
ASSISTANT     public ResponseEntity<Void> delete(@PathVariable Long id) {
ASSISTANT         if (!service.findById(id).isPresent()) return ResponseEntity.notFound().build();
ASSISTANT         service.deleteById(id);
ASSISTANT         return ResponseEntity.noContent().build();
ASSISTANT     }
ASSISTANT 
ASSISTANT     @GetMapping("/search")
ASSISTANT     public List<Contact> search(@RequestParam String q) { return service.search(q); }
ASSISTANT }
