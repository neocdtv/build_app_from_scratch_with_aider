ASSISTANT package com.addressbook.config;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.repository.ContactRepository;
ASSISTANT import org.springframework.boot.CommandLineRunner;
ASSISTANT import org.springframework.stereotype.Component;
ASSISTANT 
ASSISTANT @Component
ASSISTANT public class DatabaseInitializer implements CommandLineRunner {
ASSISTANT 
ASSISTANT     private final ContactRepository contactRepository;
ASSISTANT 
ASSISTANT     public DatabaseInitializer(ContactRepository contactRepository) {
ASSISTANT         this.contactRepository = contactRepository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     @Override
ASSISTANT     public void run(String... args) throws Exception {
ASSISTANT         if (contactRepository.count() > 0) return;
ASSISTANT 
ASSISTANT         contactRepository.save(createContact(1L, "John", "Doe", "john.doe@example.com", "+1-555-1234", "123 Main Street, Anytown, USA", "Family"));
ASSISTANT         contactRepository.save(createContact(2L, "Jane", "Smith", "jane.smith@example.com", "+1-555-5678", "456 Oak Avenue, Somewhere, USA", "Work"));
ASSISTANT         contactRepository.save(createContact(3L, "Alice", "Johnson", "alice.j@example.com", "+1-555-9012", "789 Pine Road, Elsewhere, USA", "Friends"));
ASSISTANT         contactRepository.save(createContact(4L, "Bob", "Brown", "bob.brown@example.com", "+1-555-3456", "321 Maple Lane, Nearby, USA", "Work"));
ASSISTANT         contactRepository.save(createContact(5L, "Charlie", "Davis", "charlie.davis@example.com", "+1-555-7890", "654 Cedar Blvd, Faraway, USA", "Family"));
ASSISTANT     }
ASSISTANT 
ASSISTANT     private Contact createContact(Long id, String first, String last, String email, String phone, String address, String category) {
ASSISTANT         Contact c = new Contact();
ASSISTANT         c.setId(id);
ASSISTANT         c.setFirstName(first);
ASSISTANT         c.setLastName(last);
ASSISTANT         c.setEmail(email);
ASSISTANT         c.setPhoneNumber(phone);
ASSISTANT         c.setAddress(address);
ASSISTANT         c.setCategory(category);
ASSISTANT         return c;
ASSISTANT     }
ASSISTANT }
