USER @Service
USER public class ContactService {
USER     private final ContactRepository repository;
USER 
USER     public ContactService(ContactRepository repository) {
USER         this.repository = repository;
USER     }
USER 
USER     public List<Contact> findAll() {
USER         return repository.findAll();
USER     }
USER 
USER     public Contact findById(Long id) {
USER         return repository.findById(id)
USER                 .orElseThrow(() -> new NoSuchElementException("Contact not found with id: " + id));
USER     }
USER 
USER     public Contact save(Contact contact) {
USER         return repository.save(contact);
USER     }
USER 
USER     public void deleteById(Long id) {
USER         if (!repository.existsById(id)) {
USER             throw new NoSuchElementException("Contact not found with id: " + id);
USER         }
USER         repository.deleteById(id);
USER     }
USER 
USER     public List<Contact> search(String query) {
USER         if (query == null || query.trim().isEmpty()) {
USER             return findAll();
USER         }
USER         String q = query.toLowerCase();
USER         List<Contact> byName = repository.findByFirstNameContainingIgnoreCaseOrLastNameContainingIgnoreCase(q, q);
USER         List<Contact> byCategory = repository.findByCategoryContainingIgnoreCase(q);
USER         
USER         // Merge and deduplicate
USER         List<Contact> merged = new java.util.ArrayList<>(byName);
USER         for (Contact c : byCategory) {
USER             if (merged.stream().noneMatch(existing -> existing.getId().equals(c.getId()))) {
USER                 merged.add(c);
USER             }
USER         }
USER         return merged;
USER     }
USER }
USER ```
