ASSISTANT ### 5. `src/main/java/com/addressbook/repository/ContactRepository.java`
ASSISTANT ```java
ASSISTANT package com.addressbook.repository;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import org.springframework.data.jpa.repository.JpaRepository;
ASSISTANT import org.springframework.data.jpa.repository.Query;
ASSISTANT import org.springframework.data.repository.query.Param;
ASSISTANT import org.springframework.stereotype.Repository;
ASSISTANT 
ASSISTANT import java.util.List;
ASSISTANT 
ASSISTANT @Repository
ASSISTANT public interface ContactRepository extends JpaRepository<Contact, Long> {
ASSISTANT     @Query("SELECT c FROM Contact c WHERE LOWER(c.firstName) LIKE LOWER(CONCAT('%', :query, '%')) " +
ASSISTANT            "OR LOWER(c.lastName) LIKE LOWER(CONCAT('%', :query, '%')) " +
ASSISTANT            "OR LOWER(c.category) LIKE LOWER(CONCAT('%', :query, '%'))")
ASSISTANT     List<Contact> searchContacts(@Param("query") String query);
ASSISTANT }
ASSISTANT ```
