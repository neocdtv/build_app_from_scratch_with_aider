ASSISTANT import java.util.List;
ASSISTANT 
ASSISTANT @Service
ASSISTANT @Transactional
ASSISTANT public class ContactService {
ASSISTANT     private final ContactRepository repository;
ASSISTANT 
ASSISTANT     public ContactService(ContactRepository repository) {
ASSISTANT         this.repository = repository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> findAll() { return repository.findAll(); }
ASSISTANT     public Contact findById(Long id) { return repository.findById(id).orElseThrow(() -> new NoSuchElementException("Contact not found")); }
ASSISTANT     public Contact create(Contact contact) { return repository.save(contact); }
ASSISTANT     public Contact update(Long id, Contact updated) {
ASSISTANT         Contact existing = findById(id);
ASSISTANT         existing.setFirstName(updated.getFirstName());
ASSISTANT         existing.setLastName(updated.getLastName());
ASSISTANT         existing.setEmail(updated.getEmail());
ASSISTANT         existing.setPhoneNumber(updated.getPhoneNumber());
ASSISTANT         existing.setAddress(updated.getAddress());
ASSISTANT         existing.setCategory(updated.getCategory());
ASSISTANT         return repository.save(existing);
ASSISTANT     }
ASSISTANT     public void delete(Long id) {
ASSISTANT         if (!repository.existsById(id)) throw new NoSuchElementException("Contact not found");
ASSISTANT         repository.deleteById(id);
ASSISTANT     }
ASSISTANT     public List<Contact> search(String query) { return query != null && !query.isBlank() ? repository.searchByNameOrCategory(query) : findAll(); }
ASSISTANT }
ASSISTANT ```
