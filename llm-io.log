ASSISTANT #### 4. `src/main/java/com/addressbook/model/Contact.java`
ASSISTANT Map the entity with JPA and Jakarta Validation as detailed in Section 1 of ARCHITECTURE.md.
ASSISTANT 
ASSISTANT ```java
ASSISTANT package com.addressbook.model;
ASSISTANT 
ASSISTANT import jakarta.persistence.Entity;
ASSISTANT import jakarta.persistence.GeneratedValue;
ASSISTANT import jakarta.persistence.GenerationType;
ASSISTANT import jakarta.persistence.Id;
ASSISTANT import jakarta.persistence.Table;
ASSISTANT import jakarta.validation.constraints.Email;
ASSISTANT import jakarta.validation.constraints.Max;
ASSISTANT import jakarta.validation.constraints.NotBlank;
ASSISTANT 
ASSISTANT @Entity
ASSISTANT @Table(name = "contact")
ASSISTANT public class Contact {
ASSISTANT 
ASSISTANT     @Id
ASSISTANT     @GeneratedValue(strategy = GenerationType.IDENTITY)
ASSISTANT     private Long id;
ASSISTANT 
ASSISTANT     @NotBlank(message = "First name is required")
ASSISTANT     @Max(value = 50, message = "First name cannot exceed 50 characters")
ASSISTANT     private String firstName;
ASSISTANT 
ASSISTANT     @NotBlank(message = "Last name is required")
ASSISTANT     @Max(value = 50, message = "Last name cannot exceed 50 characters")
ASSISTANT     private String lastName;
ASSISTANT 
ASSISTANT     @NotBlank(message = "Email is required")
ASSISTANT     @Email(message = "Invalid email format")
ASSISTANT     @Max(value = 100, message = "Email cannot exceed 100 characters")
ASSISTANT     private String email;
ASSISTANT 
ASSISTANT     @NotBlank(message = "Phone number is required")
ASSISTANT     @Max(value = 20, message = "Phone number cannot exceed 20 characters")
ASSISTANT     private String phoneNumber;
ASSISTANT 
ASSISTANT     @NotBlank(message = "Address is required")
ASSISTANT     @Max(value = 255, message = "Address cannot exceed 255 characters")
ASSISTANT     private String address;
ASSISTANT 
ASSISTANT     @NotBlank(message = "Category is required")
ASSISTANT     @Max(value = 50, message = "Category cannot exceed 50 characters")
ASSISTANT     private String category;
ASSISTANT 
ASSISTANT     // Getters and Setters
ASSISTANT     public Long getId() { return id; }
ASSISTANT     public void setId(Long id) { this.id = id; }
ASSISTANT 
ASSISTANT     public String getFirstName() { return firstName; }
ASSISTANT     public void setFirstName(String firstName) { this.firstName = firstName; }
ASSISTANT 
ASSISTANT     public String getLastName() { return lastName; }
ASSISTANT     public void setLastName(String lastName) { this.lastName = lastName; }
ASSISTANT 
ASSISTANT     public String getEmail() { return email; }
ASSISTANT     public void setEmail(String email) { this.email = email; }
ASSISTANT 
ASSISTANT     public String getPhoneNumber() { return phoneNumber; }
ASSISTANT     public void setPhoneNumber(String phoneNumber) { this.phoneNumber = phoneNumber; }
ASSISTANT 
ASSISTANT     public String getAddress() { return address; }
ASSISTANT     public void setAddress(String address) { this.address = address; }
ASSISTANT 
ASSISTANT     public String getCategory() { return category; }
ASSISTANT     public void setCategory(String category) { this.category = category; }
ASSISTANT }
ASSISTANT ```
