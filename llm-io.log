USER 
USER         if (!Object.values(payload).every(v => v)) {
USER             alert('All fields are required.'); return;
USER         }
USER 
USER         const url = id ? `/api/contacts/${id}` : '/api/contacts';
USER         await fetch(url, { method: id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
USER         form.reset(); document.getElementById('contactId').value = ''; toggleBtn.click(); loadContacts(searchInput.value);
USER     });
USER 
USER     searchInput.addEventListener('input', e => loadContacts(e.target.value));
USER     toggleBtn.addEventListener('click', () => { form.classList.toggle('active'); if (!form.classList.contains('active')) form.reset(); });
USER     cancelBtn.addEventListener('click', () => { form.classList.remove('active'); form.reset(); });
USER 
USER     tableBody.addEventListener('click', async (e) => {
USER         const id = e.target.dataset.id; if (!id) return;
