ASSISTANT ```java
ASSISTANT package com.addressbook.service;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.repository.ContactRepository;
ASSISTANT import org.springframework.stereotype.Service;
ASSISTANT import java.util.List;
ASSISTANT import java.util.Optional;
ASSISTANT 
ASSISTANT @Service
ASSISTANT public class ContactService {
ASSISTANT 
ASSISTANT     private final ContactRepository contactRepository;
ASSISTANT 
ASSISTANT     public ContactService(ContactRepository contactRepository) {
ASSISTANT         this.contactRepository = contactRepository;
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> findAll() {
ASSISTANT         return contactRepository.findAll();
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Optional<Contact> findById(Long id) {
ASSISTANT         return contactRepository.findById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public Contact save(Contact contact) {
ASSISTANT         return contactRepository.save(contact);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public void deleteById(Long id) {
ASSISTANT         if (!contactRepository.existsById(id)) {
ASSISTANT             throw new RuntimeException("Contact not found with id: " + id);
ASSISTANT         }
ASSISTANT         contactRepository.deleteById(id);
ASSISTANT     }
ASSISTANT 
ASSISTANT     public List<Contact> search(String query) {
ASSISTANT         if (query == null || query.isBlank()) {
ASSISTANT             return findAll();
ASSISTANT         }
ASSISTANT         return contactRepository.findByFirstNameContainingOrLastNameContainingOrCategoryContaining(query, query, query);
ASSISTANT     }
ASSISTANT }
