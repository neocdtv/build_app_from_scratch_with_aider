USER const API_URL = '/api/contacts';
USER 
USER document.addEventListener('DOMContentLoaded', loadContacts);
USER 
USER // Search functionality
USER document.getElementById('searchInput').addEventListener('input', (e) => {
USER     const query = e.target.value;
USER     if (query.length === 0) {
USER         loadContacts();
USER     } else {
USER         searchContacts(query);
USER     }
USER });
USER 
USER async function loadContacts() {
USER     try {
USER         const res = await fetch(API_URL);
USER         const contacts = await res.json();
USER         renderTable(contacts);
USER     } catch (error) {
USER         console.error('Error loading contacts:', error);
USER     }
USER }
USER 
USER async function searchContacts(query) {
USER     try {
USER         const res = await fetch(`${API_URL}/search?q=${encodeURIComponent(query)}`);
USER         const contacts = await res.json();
USER         renderTable(contacts);
USER     } catch (error) {
USER         console.error('Error searching:', error);
USER     }
USER }
USER 
USER function renderTable(contacts) {
USER     const tbody = document.querySelector('#contactsTable tbody');
USER     tbody.innerHTML = '';
USER 
USER     contacts.forEach(contact => {
USER         const tr = document.createElement('tr');
USER         tr.innerHTML = `
USER             <td>${contact.firstName} ${contact.lastName}</td>
USER             <td>${contact.email}</td>
USER             <td>${contact.phoneNumber}</td>
USER             <td>${contact.category}</td>
USER             <td>
USER                 <button class="action-btn edit-btn" onclick="editContact(${contact.id})">Edit</button>
USER                 <button class="action-btn delete-btn" onclick="deleteContact(${contact.id})">Delete</button>
USER             </td>
USER         `;
USER         tbody.appendChild(tr);
USER     });
USER }
USER 
USER function resetForm() {
USER     document.getElementById('contactForm').reset();
USER     document.getElementById('contactId').value = '';
USER     document.getElementById('submitBtn').textContent = 'Save';
USER }
USER 
USER async function handleSubmit(e) {
USER     e.preventDefault();
USER     const id = document.getElementById('contactId').value;
USER     const contactData = getFormData();
USER 
USER     try {
USER         if (id) {
USER             // Update
USER             await fetch(`${API_URL}/${id}`, {
USER                 method: 'PUT',
USER                 headers: { 'Content-Type': 'application/json' },
USER                 body: JSON.stringify(contactData)
USER             });
USER         } else {
USER             // Create
USER             await fetch(API_URL, {
USER                 method: 'POST',
USER                 headers: { 'Content-Type': 'application/json' },
USER                 body: JSON.stringify(contactData)
USER             });
USER         }
USER         resetForm();
USER         loadContacts();
USER     } catch (error) {
USER         alert('Error saving contact. Check console for details.');
USER         console.error(error);
USER     }
USER }
USER 
USER async function editContact(id) {
USER     try {
USER         const res = await fetch(`${API_URL}/${id}`);
USER         const contact = await res.json();
USER         
USER         document.getElementById('contactId').value = contact.id;
USER         document.getElementById('firstName').value = contact.firstName;
USER         document.getElementById('lastName').value = contact.lastName;
USER         document.getElementById('email').value = contact.email;
USER         document.getElementById('phoneNumber').value = contact.phoneNumber;
USER         document.getElementById('address').value = contact.address;
USER         document.getElementById('category').value = contact.category;
USER 
USER         document.getElementById('submitBtn').textContent = 'Update';
USER         window.scrollTo(0, 0);
USER     } catch (error) {
USER         console.error('Error fetching contact:', error);
USER     }
USER }
USER 
USER async function deleteContact(id) {
USER     if (confirm('Are you sure you want to delete this contact?')) {
USER         try {
USER             await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
USER             loadContacts();
USER         } catch (error) {
USER             alert('Error deleting contact.');
USER             console.error(error);
USER         }
USER     }
USER }
USER 
USER function getFormData() {
USER     return {
USER         firstName: document.getElementById('firstName').value,
USER         lastName: document.getElementById('lastName').value,
USER         email: document.getElementById('email').value,
USER         phoneNumber: document.getElementById('phoneNumber').value,
USER         address: document.getElementById('address').value,
USER         category: document.getElementById('category').value
