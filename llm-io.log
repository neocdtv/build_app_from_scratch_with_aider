USER ```java
USER package com.addressbook.controller;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.service.ContactService;
USER import jakarta.validation.Valid;
USER import lombok.RequiredArgsConstructor;
USER import org.springframework.http.HttpStatus;
USER import org.springframework.http.ResponseEntity;
USER import org.springframework.validation.annotation.Validated;
USER import org.springframework.web.bind.MethodArgumentNotValidException;
USER import org.springframework.web.bind.annotation.*;
USER import java.util.List;
USER import java.util.Map;
USER 
USER @RestController
USER @RequestMapping("/api/contacts")
USER @RequiredArgsConstructor
USER @Validated
USER public class ContactController {
USER     private final ContactService service;
USER 
USER     @GetMapping
USER     public List<Contact> getAll() {
USER         return service.findAll();
USER     }
USER 
USER     @GetMapping("/{id}")
USER     public ResponseEntity<Contact> getById(@PathVariable Long id) {
USER         return service.findById(id)
USER                 .map(ResponseEntity::ok)
USER                 .orElseGet(() -> ResponseEntity.status(HttpStatus.NOT_FOUND).build());
USER     }
USER 
USER     @PostMapping
USER     public ResponseEntity<Contact> create(@Valid @RequestBody Contact contact) {
USER         return ResponseEntity.status(HttpStatus.CREATED).body(service.create(contact));
USER     }
USER 
USER     @PutMapping("/{id}")
USER     public ResponseEntity<Contact> update(@PathVariable Long id, @Valid @RequestBody Contact contact) {
USER         try {
USER             return ResponseEntity.ok(service.update(id, contact));
USER         } catch (RuntimeException e) {
USER             return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
USER         }
USER     }
USER 
USER     @DeleteMapping("/{id}")
USER     public ResponseEntity<Void> delete(@PathVariable Long id) {
USER         try {
USER             service.deleteById(id);
USER             return ResponseEntity.noContent().build();
USER         } catch (RuntimeException e) {
USER             return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
USER         }
USER     }
USER 
USER     @GetMapping("/search")
USER     public List<Contact> search(@RequestParam String q) {
USER         return service.search(q);
USER     }
USER 
USER     @ExceptionHandler(MethodArgumentNotValidException.class)
USER     public ResponseEntity<Map<String, String>> handleValidationExceptions(MethodArgumentNotValidException ex) {
USER         Map<String, String> errors = ex.getBindingResult().getFieldErrors().stream()
USER                 .collect(java.util.stream.Collectors.toMap(e -> e.getField(), e -> e.getDefaultMessage()));
USER         return ResponseEntity.badRequest().body(errors);
USER     }
USER }
USER ```
