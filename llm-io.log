USER ### 8. `src/main/java/com/addressbook/config/DataInitializer.java`
USER ```java
USER package com.addressbook.config;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import org.springframework.boot.CommandLineRunner;
USER import org.springframework.context.annotation.Bean;
USER import org.springframework.context.annotation.Configuration;
USER 
USER @Configuration
USER public class DataInitializer {
USER 
USER     @Bean
USER     CommandLineRunner initData(ContactRepository repository) {
USER         return args -> {
USER             if (repository.count() == 0) {
USER                 repository.save(createSample("John", "Doe", "john.doe@example.com", "+1-555-0101", "123 Main St, Anytown", "Family"));
USER                 repository.save(createSample("Jane", "Smith", "jane.smith@work.com", "+1-555-0102", "456 Oak Ave, Workville", "Work"));
USER                 repository.save(createSample("Alice", "Johnson", "alice.j@mail.com", "+1-555-0103", "789 Pine Ln, Suburbia", "Friends"));
USER                 repository.save(createSample("Bob", "Williams", "bob.w@example.net", "+1-555-0104", "321 Elm St, City", "Work"));
USER                 repository.save(createSample("Carol", "Brown", "carol.b@domain.org", "+1-555-0105", "654 Maple Dr, Town", "Family"));
USER             }
USER         };
USER     }
USER 
USER     private Contact createSample(String first, String last, String email, String phone, String address, String category) {
USER         Contact c = new Contact();
USER         c.setFirstName(first); c.setLastName(last);
USER         c.setEmail(email); c.setPhoneNumber(phone);
USER         c.setAddress(address); c.setCategory(category);
USER         return c;
USER     }
USER }
USER ```
