USER ### 5. Repository (`ContactRepository.java`)
USER Create `src/main/java/com/addressbook/repository/ContactRepository.java`. Extend `JpaRepository` and define custom search methods.
USER 
USER ```java
USER package com.addressbook.repository;
USER 
USER import com.addressbook.model.Contact;
USER import org.springframework.data.jpa.repository.JpaRepository;
USER import org.springframework.data.jpa.repository.Query;
USER import org.springframework.stereotype.Repository;
USER 
USER import java.util.List;
USER 
USER @Repository
USER public interface ContactRepository extends JpaRepository<Contact, Long> {
USER 
USER     @Query("SELECT c FROM Contact c WHERE c.firstName LIKE %?1% OR c.lastName LIKE %?1%")
USER     List<Contact> findByFirstNameOrLastNameContainingIgnoreCase(String keyword);
USER 
USER     @Query("SELECT c FROM Contact c WHERE c.category = ?1")
USER     List<Contact> findByCategory(String category);
USER }
USER ```
USER 
USER ### 6. Service (`ContactService.java`)
USER Create `src/main/java/com/addressbook/service/ContactService.java`. Implement business logic for CRUD operations and search queries.
USER 
USER ```java
USER package com.addressbook.service;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import org.springframework.stereotype.Service;
USER import org.springframework.transaction.annotation.Transactional;
USER 
USER import java.util.ArrayList;
USER import java.util.HashSet;
USER import java.util.List;
USER import java.util.Optional;
USER import java.util.Set;
USER 
USER @Service
USER @Transactional
USER public class ContactService {
USER 
USER     private final ContactRepository contactRepository;
USER 
USER     public ContactService(ContactRepository contactRepository) {
USER         this.contactRepository = contactRepository;
USER     }
USER 
USER     public List<Contact> findAll() {
USER         return contactRepository.findAll();
USER     }
USER 
USER     public Optional<Contact> findById(Long id) {
USER         return contactRepository.findById(id);
USER     }
USER 
USER     public Contact create(Contact contact) {
USER         return contactRepository.save(contact);
USER     }
USER 
USER     public Contact update(Long id, Contact contact) {
USER         if (contact.getId() != null && !contact.getId().equals(id)) {
USER             throw new IllegalArgumentException("ID mismatch");
USER         }
USER         contact.setId(id);
USER         return contactRepository.save(contact);
USER     }
USER 
USER     public void delete(Long id) {
USER         contactRepository.deleteById(id);
USER     }
USER 
USER     public List<Contact> searchByQuery(String query) {
USER         if (query == null || query.trim().isEmpty()) {
USER             return findAll();
USER         }
USER         
USER         String nameQuery = query;
USER         if (query.contains(" ")) {
USER             nameQuery = query.substring(0, query.indexOf(" "));
USER         }
USER         
USER         List<Contact> byName = contactRepository.findByFirstNameOrLastNameContainingIgnoreCase(nameQuery);
USER         List<Contact> byCategory = contactRepository.findByCategory(query);
USER         
USER         Set<Contact> combined = new HashSet<>(byName);
USER         combined.addAll(byCategory);
USER         return new ArrayList<>(combined);
USER     }
USER }
USER ```
USER 
USER ### 7. REST Controller (`ContactController.java`)
USER Create `src/main/java/com/addressbook/controller/ContactController.java`. Map REST endpoints to service methods.
USER 
USER ```java
USER package com.addressbook.controller;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.service.ContactService;
USER import jakarta.validation.Valid;
USER import org.springframework.http.HttpStatus;
USER import org.springframework.http.ResponseEntity;
USER import org.springframework.web.bind.annotation.*;
USER 
USER import java.util.List;
USER 
USER @RestController
USER @RequestMapping("/api/contacts")
USER public class ContactController {
USER 
USER     private final ContactService contactService;
USER 
USER     public ContactController(ContactService contactService) {
USER         this.contactService = contactService;
USER     }
USER 
USER     @GetMapping
USER     public List<Contact> getAllContacts() {
USER         return contactService.findAll();
USER     }
USER 
USER     @GetMapping("/{id}")
USER     public ResponseEntity<Contact> getContactById(@PathVariable Long id) {
USER         return contactService.findById(id)
USER                 .map(contact -> new ResponseEntity<>(contact, HttpStatus.OK))
USER                 .orElseGet(() -> new ResponseEntity<>(HttpStatus.NOT_FOUND));
USER     }
USER 
USER     @PostMapping
USER     public ResponseEntity<Contact> createContact(@Valid @RequestBody Contact contact) {
USER         return new ResponseEntity<>(contactService.create(contact), HttpStatus.CREATED);
USER     }
USER 
USER     @PutMapping("/{id}")
USER     public ResponseEntity<Contact> updateContact(@PathVariable Long id, @Valid @RequestBody Contact contact) {
USER         try {
USER             Contact updated = contactService.update(id, contact);
USER             return new ResponseEntity<>(updated, HttpStatus.OK);
USER         } catch (IllegalArgumentException e) {
USER             return new ResponseEntity<>(HttpStatus.BAD_REQUEST);
USER         }
USER     }
USER 
USER     @DeleteMapping("/{id}")
USER     public ResponseEntity<Void> deleteContact(@PathVariable Long id) {
USER         contactService.delete(id);
USER         return new ResponseEntity<>(HttpStatus.NO_CONTENT);
USER     }
USER 
USER     @GetMapping("/search")
USER     public List<Contact> searchContacts(@RequestParam(required = false, defaultValue = "") String q) {
USER         return contactService.searchByQuery(q);
USER     }
USER }
USER ```
