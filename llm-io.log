USER src/main/java/com/addressbook/service/ContactService.java
USER ````
USER package com.addressbook.service;
USER 
USER import com.addressbook.model.Contact;
USER import com.addressbook.repository.ContactRepository;
USER import org.springframework.stereotype.Service;
USER import java.util.List;
USER 
USER @Service
USER public class ContactService {
USER     private final ContactRepository repository;
USER 
USER     public ContactService(ContactRepository repository) {
USER         this.repository = repository;
USER     }
USER 
USER     public List<Contact> getAllContacts() { return repository.findAll(); }
USER     public Contact getContactById(Long id) { return repository.findById(id).orElseThrow(); }
USER     public Contact createContact(Contact contact) { return repository.save(contact); }
USER     public Contact updateContact(Long id, Contact details) {
USER         Contact contact = getContactById(id);
USER         contact.setFirstName(details.getFirstName());
USER         contact.setLastName(details.getLastName());
USER         contact.setEmail(details.getEmail());
USER         contact.setPhoneNumber(details.getPhoneNumber());
USER         contact.setAddress(details.getAddress());
USER         contact.setCategory(details.getCategory());
USER         return repository.save(contact);
USER     }
USER     public void deleteContact(Long id) { repository.deleteById(id); }
USER     public List<Contact> searchContacts(String query) { return repository.search(query); }
USER }
USER ````
