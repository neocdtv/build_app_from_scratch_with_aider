USER #### 12. `src/main/resources/static/js/app.js`
USER Vanilla JavaScript to handle Fetch API calls and client-side validation.
USER 
USER ```javascript
USER document.addEventListener('DOMContentLoaded', () => {
USER     const apiUrl = '/api/contacts';
USER     let editingId = null;
USER 
USER     // DOM Elements
USER     const contactList = document.getElementById('contact-list');
USER     const formOverlay = document.getElementById('form-overlay');
USER     const contactForm = document.getElementById('contact-form');
USER     const saveBtn = document.getElementById('save-btn');
USER     const cancelBtn = document.getElementById('cancel-btn');
USER     const searchInput = document.getElementById('search-input');
USER     const searchBtn = document.getElementById('search-btn');
USER     const resetBtn = document.getElementById('reset-btn');
USER 
USER     // Load all contacts on init
USER     loadContacts();
USER 
USER     // --- CRUD Operations ---
USER 
USER     // GET (Load All)
USER     async function loadContacts() {
USER         try {
USER             const response = await fetch(apiUrl);
USER             const contacts = await response.json();
USER             renderContacts(contacts);
USER         } catch (error) {
USER             console.error('Error loading contacts:', error);
USER         }
USER     }
USER 
USER     // GET Search (Filter)
USER     async function searchContacts() {
USER         const query = searchInput.value.trim();
USER         if (!query) {
USER             loadContacts(); // If empty, load all
USER             return;
USER         }
USER         try {
USER             const response = await fetch(`${apiUrl}/search?q=${encodeURIComponent(query)}`);
USER             const contacts = await response.json();
USER             renderContacts(contacts);
USER         } catch (error) {
USER             console.error('Error searching contacts:', error);
USER         }
USER     }
USER 
USER     // POST (Create)
USER     async function createContact(formData) {
USER         try {
USER             const response = await fetch(apiUrl, {
USER                 method: 'POST',
USER                 headers: { 'Content-Type': 'application/json' },
USER                 body: JSON.stringify(formData)
USER             });
USER             if (response.ok) {
USER                 closeModal();
USER                 loadContacts();
USER                 contactForm.reset();
USER             } else {
USER                 alert('Failed to create contact.');
USER             }
USER         } catch (error) {
USER             console.error('Error creating contact:', error);
USER         }
USER     }
USER 
USER     // PUT (Update)
USER     async function updateContact(id, formData) {
USER         try {
USER             const response = await fetch(`${apiUrl}/${id}`, {
USER                 method: 'PUT',
USER                 headers: { 'Content-Type': 'application/json' },
USER                 body: JSON.stringify(formData)
USER             });
USER             if (response.ok) {
USER                 closeModal();
USER                 loadContacts();
USER             } else {
USER                 alert('Failed to update contact.');
USER             }
USER         } catch (error) {
USER             console.error('Error updating contact:', error);
USER         }
USER     }
USER 
USER     // DELETE
USER     async function deleteContact(id) {
USER         if (!confirm('Are you sure you want to delete this contact?')) return;
USER         try {
USER             const response = await fetch(`${apiUrl}/${id}`, { method: 'DELETE' });
USER             if (response.ok) {
USER                 loadContacts();
USER             } else {
USER                 alert('Failed to delete contact.');
USER             }
USER         } catch (error) {
USER             console.error('Error deleting contact:', error);
USER         }
USER     }
USER 
USER     // --- UI Helpers ---
USER 
USER     function renderContacts(contacts) {
USER         contactList.innerHTML = '';
USER         if (contacts.length === 0) {
USER             contactList.innerHTML = '<tr><td colspan="5">No contacts found.</td></tr>';
USER             return;
USER         }
USER 
USER         contacts.forEach(contact => {
USER             const row = document.createElement('tr');
USER             row.innerHTML = `
USER                 <td>${contact.firstName} ${contact.lastName}</td>
USER                 <td>${contact.email}</td>
USER                 <td>${contact.phoneNumber}</td>
USER                 <td>${contact.category}</td>
USER                 <td>
USER                     <button class="edit-btn" onclick="editContact(${contact.id})">Edit</button>
USER                     <button class="delete-btn" onclick="deleteContact(${contact.id})">Delete</button>
USER                 </td>
USER             `;
USER             contactList.appendChild(row);
USER         });
USER     }
USER 
USER     // --- Form Handling ---
USER 
USER     function openForm() {
USER         editingId = null;
USER         document.getElementById('form-title').textContent = 'Add Contact';
USER         saveBtn.textContent = 'Save';
USER         contactForm.reset();
USER         formOverlay.classList.add('show');
USER     }
USER 
USER     function closeModal() {
USER         formOverlay.classList.remove('show');
USER         editingId = null;
USER     }
USER 
USER     // Expose editContact and deleteContact to window so HTML onclick can call them
USER     window.editContact = function(id) {
USER         editingId = id;
USER         document.getElementById('form-title').textContent = 'Edit Contact';
USER         saveBtn.textContent = 'Update';
USER         
USER         fetch(`${apiUrl}/${id}`)
USER             .then(res => res.json())
USER             .then(contact => {
USER                 document.getElementById('contact-id').value = contact.id;
USER                 document.getElementById('first-name').value = contact.firstName;
USER                 document.getElementById('last-name').value = contact.lastName;
USER                 document.getElementById('email').value = contact.email;
USER                 document.getElementById('phone-number').value = contact.phoneNumber;
USER                 document.getElementById('address').value = contact.address;
USER                 document.getElementById('category').value = contact.category;
USER                 formOverlay.classList.add('show');
USER             })
USER             .catch(err => console.error('Error fetching contact for edit:', err));
USER     };
USER 
USER     // Form Submit Event
USER     contactForm.addEventListener('submit', async (e) => {
USER         e.preventDefault();
USER 
USER         const formData = {
USER             firstName: document.getElementById('first-name').value,
USER             lastName: document.getElementById('last-name').value,
USER             email: document.getElementById('email').value,
USER             phoneNumber: document.getElementById('phone-number').value,
USER             address: document.getElementById('address').value,
USER             category: document.getElementById('category').value
USER         };
USER 
USER         // Client-side validation (additional to backend @Valid)
USER         const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
USER         if (!emailRegex.test(formData.email)) {
USER             alert('Invalid email format.');
USER             return;
USER         }
USER 
USER         if (editingId) {
USER             await updateContact(editingId, formData);
USER         } else {
USER             await createContact(formData);
USER         }
USER     });
USER 
USER     // Event Listeners
USER     cancelBtn.addEventListener('click', closeModal);
USER     searchBtn.addEventListener('click', searchContacts);
USER     
USER     resetBtn.addEventListener('click', () => {
USER         searchInput.value = '';
USER         loadContacts();
USER     });
USER });
USER ```
