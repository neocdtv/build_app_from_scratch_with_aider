ASSISTANT async function fetchContacts() {
ASSISTANT     try {
ASSISTANT         const response = await fetch('/api/contacts');
ASSISTANT         if (!response.ok) throw new Error('Failed to fetch contacts');
ASSISTANT         const contacts = await response.json();
ASSISTANT         renderContacts(contacts);
ASSISTANT     } catch (error) {
ASSISTANT         console.error(error);
ASSISTANT         alert('Error fetching contacts: ' + error.message);
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT function renderContacts(contacts) {
ASSISTANT     const tableBody = document.getElementById('contactsTableBody');
ASSISTANT     tableBody.innerHTML = '';
ASSISTANT 
ASSISTANT     contacts.forEach(contact => {
ASSISTANT         const row = document.createElement('tr');
ASSISTANT         row.innerHTML = `
ASSISTANT             <td>${contact.id}</td>
ASSISTANT             <td>${escapeHtml(contact.firstName)}</td>
ASSISTANT             <td>${escapeHtml(contact.lastName)}</td>
ASSISTANT             <td>${escapeHtml(contact.email)}</td>
ASSISTANT             <td>${escapeHtml(contact.phoneNumber)}</td>
ASSISTANT             <td>${escapeHtml(contact.address)}</td>
ASSISTANT             <td>${escapeHtml(contact.category)}</td>
ASSISTANT             <td>
ASSISTANT                 <button class="btn-edit" onclick="editContact(${contact.id})">Edit</button>
ASSISTANT                 <button class="btn-delete" onclick="deleteContact(${contact.id})">Delete</button>
ASSISTANT             </td>
ASSISTANT         `;
ASSISTANT         tableBody.appendChild(row);
ASSISTANT     });
ASSISTANT }
ASSISTANT 
ASSISTANT function escapeHtml(text) {
ASSISTANT     if (text === null || text === undefined) return '';
ASSISTANT     const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
ASSISTANT     return String(text).replace(/[&<>"']/g, function(m) { return map[m]; });
ASSISTANT }
ASSISTANT 
ASSISTANT async function searchContacts() {
