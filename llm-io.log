USER ````
USER document.addEventListener('DOMContentLoaded', function() {
USER     const searchInput = document.getElementById('searchInput');
USER     const searchBtn = document.getElementById('searchBtn');
USER     const addContactBtn = document.getElementById('addContactBtn');
USER     const contactForm = document.getElementById('contactForm');
USER     const cancelFormBtn = document.getElementById('cancelFormBtn');
USER     const contactsBody = document.getElementById('contactsBody');
USER 
USER     // Load all contacts on page load
USER     loadContacts();
USER 
USER     // Search button click handler
USER     searchBtn.addEventListener('click', function() {
USER         const query = searchInput.value.trim();
USER         if (query) {
USER             loadContacts(query);
USER         } else {
USER             loadContacts();
USER         }
USER     });
USER 
USER     // Add contact button click handler
USER     addContactBtn.addEventListener('click', function() {
USER         contactForm.style.display = 'flex';
USER         clearForm();
USER     });
USER 
USER     // Cancel form button click handler
USER     cancelFormBtn.addEventListener('click', function() {
USER         contactForm.style.display = 'none';
USER         clearForm();
USER     });
USER 
USER     // Form submit handler
USER     contactForm.addEventListener('submit', function(e) {
USER         e.preventDefault();
USER         const contactId = document.getElementById('contactId').value;
USER         const contactData = {
USER             firstName: document.getElementById('firstName').value,
USER             lastName: document.getElementById('lastName').value,
USER             email: document.getElementById('email').value,
USER             phoneNumber: document.getElementById('phoneNumber').value,
USER             address: document.getElementById('address').value,
USER             category: document.getElementById('category').value
USER         };
USER 
USER         if (contactId) {
USER             // Update existing contact
USER             updateContact(contactId, contactData);
USER         } else {
USER             // Create new contact
USER             createContact(contactData);
USER         }
USER     });
USER 
USER     function loadContacts(query = '') {
USER         const url = query ? `/api/contacts/search?q=${encodeURIComponent(query)}` : '/api/contacts';
USER         
USER         fetch(url)
USER             .then(response => response.json())
USER             .then(contacts => {
USER                 contactsBody.innerHTML = '';
USER                 contacts.forEach(contact => {
USER                     const row = document.createElement('tr');
USER                     row.innerHTML = `
USER                         <td>${contact.firstName}</td>
USER                         <td>${contact.lastName}</td>
USER                         <td>${contact.email}</td>
USER                         <td>${contact.phoneNumber}</td>
USER                         <td>${contact.address}</td>
USER                         <td>${contact.category}</td>
USER                         <td class="action-buttons">
USER                             <button class="edit-btn" onclick="editContact(${contact.id})">Edit</button>
USER                             <button class="delete-btn" onclick="deleteContact(${contact.id})">Delete</button>
USER                         </td>
USER                     `;
USER                     contactsBody.appendChild(row);
USER                 });
USER             })
USER             .catch(error => console.error('Error loading contacts:', error));
USER     }
USER 
USER     function createContact(contactData) {
USER         fetch('/api/contacts', {
USER             method: 'POST',
USER             headers: {
USER                 'Content-Type': 'application/json'
USER             },
USER             body: JSON.stringify(contactData)
USER         })
USER         .then(response => {
USER             if (response.ok) {
USER                 contactForm.style.display = 'none';
USER                 clearForm();
USER                 loadContacts();
USER             } else {
USER                 alert('Failed to create contact');
USER             }
USER         })
USER         .catch(error => console.error('Error creating contact:', error));
USER     }
USER 
USER     function updateContact(id, contactData) {
USER         fetch(`/api/contacts/${id}`, {
USER             method: 'PUT',
USER             headers: {
USER                 'Content-Type': 'application/json'
USER             },
USER             body: JSON.stringify(contactData)
USER         })
USER         .then(response => {
USER             if (response.ok) {
USER                 contactForm.style.display = 'none';
USER                 clearForm();
USER                 loadContacts();
USER             } else {
USER                 alert('Failed to update contact');
USER             }
USER         })
USER         .catch(error => console.error('Error updating contact:', error));
USER     }
USER 
USER     function deleteContact(id) {
USER         if (confirm('Are you sure you want to delete this contact?')) {
USER             fetch(`/api/contacts/${id}`, {
USER                 method: 'DELETE'
USER             })
USER             .then(response => {
USER                 if (response.ok) {
USER                     loadContacts();
USER                 } else {
USER                     alert('Failed to delete contact');
USER                 }
USER             })
USER             .catch(error => console.error('Error deleting contact:', error));
USER         }
USER     }
USER 
USER     function editContact(id) {
USER         fetch(`/api/contacts/${id}`)
USER             .then(response => response.json())
USER             .then(contact => {
USER                 document.getElementById('contactId').value = contact.id;
USER                 document.getElementById('firstName').value = contact.firstName;
USER                 document.getElementById('lastName').value = contact.lastName;
USER                 document.getElementById('email').value = contact.email;
USER                 document.getElementById('phoneNumber').value = contact.phoneNumber;
USER                 document.getElementById('address').value = contact.address;
USER                 document.getElementById('category').value = contact.category;
USER                 contactForm.style.display = 'flex';
USER             })
USER             .catch(error => console.error('Error loading contact for editing:', error));
USER     }
USER 
USER     function clearForm() {
USER         document.getElementById('contactId').value = '';
USER         document.getElementById('firstName').value = '';
USER         document.getElementById('lastName').value = '';
USER         document.getElementById('email').value = '';
USER         document.getElementById('phoneNumber').value = '';
USER         document.getElementById('address').value = '';
USER         document.getElementById('category').value = '';
USER     }
USER });
