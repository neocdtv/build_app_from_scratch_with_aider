ASSISTANT ### 8. `src/main/java/com/addressbook/config/DataInitializer.java`
ASSISTANT ```java
ASSISTANT package com.addressbook.config;
ASSISTANT 
ASSISTANT import com.addressbook.model.Contact;
ASSISTANT import com.addressbook.repository.ContactRepository;
ASSISTANT import org.springframework.boot.CommandLineRunner;
ASSISTANT import org.springframework.context.annotation.Bean;
ASSISTANT import org.springframework.context.annotation.Configuration;
ASSISTANT 
ASSISTANT @Configuration
ASSISTANT public class DataInitializer {
ASSISTANT 
ASSISTANT     @Bean
ASSISTANT     CommandLineRunner initData(ContactRepository repository) {
ASSISTANT         return args -> {
ASSISTANT             if (repository.count() == 0) {
ASSISTANT                 repository.save(createSample("John", "Doe", "john.doe@example.com", "+1-555-0101", "123 Main St, Anytown", "Family"));
ASSISTANT                 repository.save(createSample("Jane", "Smith", "jane.smith@work.com", "+1-555-0102", "456 Oak Ave, Workville", "Work"));
ASSISTANT                 repository.save(createSample("Alice", "Johnson", "alice.j@mail.com", "+1-555-0103", "789 Pine Ln, Suburbia", "Friends"));
ASSISTANT                 repository.save(createSample("Bob", "Williams", "bob.w@example.net", "+1-555-0104", "321 Elm St, City", "Work"));
ASSISTANT                 repository.save(createSample("Carol", "Brown", "carol.b@domain.org", "+1-555-0105", "654 Maple Dr, Town", "Family"));
ASSISTANT             }
ASSISTANT         };
ASSISTANT     }
ASSISTANT 
ASSISTANT     private Contact createSample(String first, String last, String email, String phone, String address, String category) {
ASSISTANT         Contact c = new Contact();
ASSISTANT         c.setFirstName(first); c.setLastName(last);
ASSISTANT         c.setEmail(email); c.setPhoneNumber(phone);
ASSISTANT         c.setAddress(address); c.setCategory(category);
ASSISTANT         return c;
ASSISTANT     }
ASSISTANT }
